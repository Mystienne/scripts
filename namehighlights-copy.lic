# encoding: utf-8
=begin

  NameHighlights Copy - merge generated highlights into Wrayth character files

  This utility copies the NameHighlights import file into every numeric Wrayth
  character XML file. It verifies the source import file and target settings
  folder first, saves those settings, and refuses to merge until you explicitly
  confirm how duplicates should be handled.

  Duplicate modes:
      replace
          Replace matching existing highlights, then add missing highlights.

      skip
          Keep matching existing highlights and only add missing highlights.

      clear
          Clear the target Name and Custom highlight sections before importing.

  Basic commands:
      ;namehighlights-copy setup
          Detect paths and print the confirmation command.

      ;namehighlights-copy confirm duplicates=replace
          Save confirmed settings and run the merge.

      ;namehighlights-copy run
          Run again using previously confirmed settings.

      ;namehighlights-copy status
          Show saved settings and whether they are confirmed.

       author: Mystienne
  contributor: Peggyanne
         game: gs
      version: 0.1.0
         tags: highlights, names, wrayth, settings, import, backup
     required: Lich >= 5.11.0
        email: Mystienne@mystienne.com
      discord: Mystienne

=end

require 'fileutils'
require 'rexml/document'
require 'time'
require 'yaml'

SCRIPT_NAME = 'namehighlights-copy'
VERSION = '0.1.0'
CONFIG_PATH = File.join(DATA_DIR, 'namehighlights-copy.yml')
USER_HOME = (Dir.home rescue nil) || ENV['USERPROFILE'] || ENV['HOME'] || DATA_DIR
DEFAULT_SOURCE = if ENV['OS'].to_s =~ /windows/i || File::ALT_SEPARATOR == '\\'
                   'C:/Gemstone IV Highlights/namehighlights-names.xml'
                 else
                   File.join(USER_HOME, 'Gemstone IV Highlights', 'namehighlights-names.xml')
                 end
LEGACY_SOURCE = File.join(USER_HOME, 'Desktop', 'namehighlights-names.xml')
DEFAULT_TARGET = if ENV['APPDATA'].to_s.strip.length > 0
                   File.join(ENV['APPDATA'], 'Wrayth', 'GS4')
                 else
                   File.join(USER_HOME, 'AppData', 'Roaming', 'Wrayth', 'GS4')
                 end
DUPLICATE_MODES = %w[replace skip clear].freeze

def nhc_echo(message = '')
  if defined?(respond)
    respond message.to_s
  elsif defined?(_respond)
    _respond message.to_s
  else
    puts message.to_s
  end
end

def load_config
  return {} unless File.exist?(CONFIG_PATH)

  data = YAML.load_file(CONFIG_PATH)
  data.is_a?(Hash) ? data : {}
rescue
  {}
end

def save_config(config)
  FileUtils.mkdir_p(File.dirname(CONFIG_PATH))
  File.write(CONFIG_PATH, config.to_yaml)
end

def arg_value(raw_args, key)
  prefix = "#{key}="
  found = raw_args.find { |arg| arg.downcase.start_with?(prefix) }
  return nil unless found

  found[(found.index('=') + 1)..-1].to_s.strip
end

def normalize_path(path)
  path.to_s.strip.tr('\\', '/')
end

def detect_source(raw_args = [])
  requested = arg_value(raw_args, 'source') || arg_value(raw_args, 'src')
  return requested if requested && requested.length > 0
  return DEFAULT_SOURCE if File.exist?(DEFAULT_SOURCE)
  return LEGACY_SOURCE if File.exist?(LEGACY_SOURCE)

  DEFAULT_SOURCE
end

def detect_target(raw_args = [])
  requested = arg_value(raw_args, 'target') || arg_value(raw_args, 'dir')
  return requested if requested && requested.length > 0

  DEFAULT_TARGET
end

def load_xml(path)
  doc = REXML::Document.new(File.read(path))
  raise "No XML root found in #{path}" unless doc.root

  doc
end

def section(doc, name)
  doc.root.elements[name]
end

def ensure_section(doc, name)
  existing = section(doc, name)
  return existing if existing

  node = doc.root.add_element(name)
  node.add_attribute('local', '')
  node
end

def highlight_nodes(section_node)
  return [] unless section_node

  section_node.get_elements('h')
end

def validate_source(path)
  raise "Source import file not found: #{path}" unless File.file?(path)

  doc = load_xml(path)
  strings = section(doc, 'strings')
  names = section(doc, 'names')
  string_count = highlight_nodes(strings).length
  name_count = highlight_nodes(names).length
  raise "Source has no Custom or Name highlight entries: #{path}" if string_count == 0 && name_count == 0

  { doc: doc, strings: strings, names: names, string_count: string_count, name_count: name_count }
end

def target_files(dir)
  raise "Target folder not found: #{dir}" unless Dir.exist?(dir)

  files = Dir.glob(File.join(dir, '*.xml')).select { |path| File.basename(path) =~ /\A\d+\.xml\z/ }.sort
  raise "No numeric Wrayth character XML files found in #{dir}" if files.empty?

  files
end

def verify_settings(source_path, target_dir)
  source = validate_source(source_path)
  files = target_files(target_dir)
  { source: source, targets: files }
end

def duplicate_mode(raw_args, config)
  requested = arg_value(raw_args, 'duplicates') || arg_value(raw_args, 'duplicate') || arg_value(raw_args, 'mode')
  mode = requested || config['duplicates'] || 'replace'
  mode = mode.to_s.downcase
  raise "Duplicate mode must be one of: #{DUPLICATE_MODES.join(', ')}" unless DUPLICATE_MODES.include?(mode)

  mode
end

def print_settings(config)
  nhc_echo "#{SCRIPT_NAME} v#{VERSION}"
  nhc_echo "Source:     #{config['source_path'] || '(not set)'}"
  nhc_echo "Target dir: #{config['target_dir'] || '(not set)'}"
  nhc_echo "Duplicates: #{config['duplicates'] || '(not set)'}"
  nhc_echo "Confirmed:  #{config['confirmed'] ? 'yes' : 'no'}"
end

def setup(raw_args)
  source_path = detect_source(raw_args)
  target_dir = detect_target(raw_args)
  mode = duplicate_mode(raw_args, {})
  verified = verify_settings(source_path, target_dir)

  config = {
    'source_path' => source_path,
    'target_dir' => target_dir,
    'duplicates' => mode,
    'confirmed' => false,
    'updated_at' => Time.now.utc.iso8601,
  }
  save_config(config)

  nhc_echo 'Detected highlight copy settings:'
  nhc_echo "  Source: #{source_path}"
  nhc_echo "    Custom highlights: #{verified[:source][:string_count]}"
  nhc_echo "    Name highlights:   #{verified[:source][:name_count]}"
  nhc_echo "  Target folder: #{target_dir}"
  nhc_echo "    Character XML files: #{verified[:targets].length}"
  nhc_echo ''
  nhc_echo 'Choose duplicate handling before the merge runs:'
  nhc_echo '  replace  Replace matching highlights and add missing ones'
  nhc_echo '  skip     Keep matching highlights and only add missing ones'
  nhc_echo '  clear    Clear Name/Custom highlights first, then import'
  nhc_echo ''
  nhc_echo 'To confirm and run:'
  nhc_echo "  ;#{SCRIPT_NAME} confirm duplicates=#{mode}"
rescue => error
  nhc_echo "Setup failed: #{error.message}"
end

def remove_matching_highlights(section_node, text)
  removed = 0
  highlight_nodes(section_node).each do |node|
    next unless node.attributes['text'].to_s.downcase == text.to_s.downcase

    section_node.delete(node)
    removed += 1
  end
  removed
end

def import_highlights(target_section, source_section, mode)
  summary = { replaced: 0, skipped: 0, added: 0 }
  return summary unless source_section

  if mode == 'clear'
    highlight_nodes(target_section).each { |node| target_section.delete(node) }
  end

  highlight_nodes(source_section).each do |source_node|
    text = source_node.attributes['text'].to_s
    next if text.strip.empty?

    existing = highlight_nodes(target_section).any? { |node| node.attributes['text'].to_s.downcase == text.downcase }
    if existing && mode == 'skip'
      summary[:skipped] += 1
      next
    end

    if existing && mode == 'replace'
      summary[:replaced] += remove_matching_highlights(target_section, text)
    end

    target_section.add_element(source_node.deep_clone)
    summary[:added] += 1
  end

  summary
end

def merge_file(target_path, source_info, mode)
  doc = load_xml(target_path)
  strings = ensure_section(doc, 'strings')
  names = ensure_section(doc, 'names')
  string_summary = import_highlights(strings, source_info[:strings], mode)
  name_summary = import_highlights(names, source_info[:names], mode)
  File.write(target_path, doc.to_s)
  { strings: string_summary, names: name_summary }
end

def run_merge(config)
  raise 'Settings are not confirmed. Run setup, then confirm duplicates=replace|skip|clear.' unless config['confirmed']

  source_path = config['source_path'].to_s
  target_dir = config['target_dir'].to_s
  mode = config['duplicates'].to_s
  raise "Duplicate mode must be one of: #{DUPLICATE_MODES.join(', ')}" unless DUPLICATE_MODES.include?(mode)

  verified = verify_settings(source_path, target_dir)
  backup_dir = File.join(target_dir, "namehighlights-copy-backup-#{Time.now.strftime('%Y%m%d-%H%M%S')}")
  FileUtils.mkdir_p(backup_dir)

  totals = Hash.new(0)
  verified[:targets].each do |target_path|
    FileUtils.cp(target_path, File.join(backup_dir, File.basename(target_path)))
    result = merge_file(target_path, verified[:source], mode)
    totals[:files] += 1
    totals[:strings_replaced] += result[:strings][:replaced]
    totals[:strings_skipped] += result[:strings][:skipped]
    totals[:strings_added] += result[:strings][:added]
    totals[:names_replaced] += result[:names][:replaced]
    totals[:names_skipped] += result[:names][:skipped]
    totals[:names_added] += result[:names][:added]
  end

  nhc_echo 'NameHighlights copy complete.'
  nhc_echo "  Source: #{source_path}"
  nhc_echo "  Backup: #{backup_dir}"
  nhc_echo "  Files updated: #{totals[:files]}"
  nhc_echo "  Custom highlights: added #{totals[:strings_added]}, replaced #{totals[:strings_replaced]}, skipped #{totals[:strings_skipped]}"
  nhc_echo "  Name highlights:   added #{totals[:names_added]}, replaced #{totals[:names_replaced]}, skipped #{totals[:names_skipped]}"
rescue => error
  nhc_echo "Copy failed: #{error.message}"
end

def confirm(raw_args)
  config = load_config
  source_path = arg_value(raw_args, 'source') || arg_value(raw_args, 'src') || config['source_path'] || detect_source(raw_args)
  target_dir = arg_value(raw_args, 'target') || arg_value(raw_args, 'dir') || config['target_dir'] || detect_target(raw_args)
  mode = duplicate_mode(raw_args, config)
  verified = verify_settings(source_path, target_dir)

  config['source_path'] = source_path
  config['target_dir'] = target_dir
  config['duplicates'] = mode
  config['confirmed'] = true
  config['confirmed_at'] = Time.now.utc.iso8601
  save_config(config)

  nhc_echo 'Confirmed highlight copy settings:'
  nhc_echo "  Source: #{source_path}"
  nhc_echo "    Custom highlights: #{verified[:source][:string_count]}"
  nhc_echo "    Name highlights:   #{verified[:source][:name_count]}"
  nhc_echo "  Target folder: #{target_dir}"
  nhc_echo "    Character XML files: #{verified[:targets].length}"
  nhc_echo "  Duplicates: #{mode}"
  run_merge(config)
rescue => error
  nhc_echo "Confirm failed: #{error.message}"
end

def usage
  nhc_echo "#{SCRIPT_NAME} v#{VERSION}"
  nhc_echo ''
  nhc_echo "  ;#{SCRIPT_NAME} setup"
  nhc_echo "  ;#{SCRIPT_NAME} confirm duplicates=replace"
  nhc_echo "  ;#{SCRIPT_NAME} confirm duplicates=skip"
  nhc_echo "  ;#{SCRIPT_NAME} confirm duplicates=clear"
  nhc_echo "  ;#{SCRIPT_NAME} run"
  nhc_echo "  ;#{SCRIPT_NAME} status"
  nhc_echo ''
  nhc_echo 'Optional: source=C:/path/file.xml target=C:/path/Wrayth/GS4'
end

raw_args = Script.current.vars.map(&:to_s)
args = raw_args.map(&:downcase)

if args.empty? || args.include?('help') || args.include?('--help') || args.include?('-h')
  usage
  exit
end

if args.include?('setup')
  setup(raw_args)
  exit
end

if args.include?('status')
  print_settings(load_config)
  exit
end

if args.include?('confirm')
  confirm(raw_args)
  exit
end

if args.include?('run')
  run_merge(load_config)
  exit
end

usage
