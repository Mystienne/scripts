account = Script.current.vars[0]

if account.nil? || account.empty?
  echo "Usage: ;lumnissetup <accountname>"
  exit
end

start_script('lumnis', ["--char-account=#{account}"])
sleep 0.2
start_script('lumnis', ['--show-account=on'])
sleep 0.2
start_script('lumnis', ['--header-repeat-rows=0'])
sleep 0.2
start_script('lumnis')