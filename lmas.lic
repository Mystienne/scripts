def lmas_script_dir
  if defined?(SCRIPT_DIR)
    SCRIPT_DIR
  else
    File.dirname(__FILE__)
  end
end

def lmas_root
  File.expand_path('..', lmas_script_dir)
end

def lmas_data_dir
  File.join(lmas_root, 'data', 'lmas')
end

def lmas_char_dir
  File.join(lmas_data_dir, 'characters')
end

def lmas_global_file
  File.join(lmas_data_dir, 'global.json')
end

def lmas_character_name
  if defined?(Char) && Char.respond_to?(:name) && Char.name
    Char.name.to_s
  elsif defined?(XMLData) && XMLData.respond_to?(:name)
    XMLData.name.to_s
  else
    'Unknown'
  end
end

def lmas_char_file(name = lmas_character_name)
  safe = name.to_s.gsub(/[^A-Za-z0-9_.-]/, '_')
  File.join(lmas_char_dir, "#{safe}.json")
end

def lmas_read_json(file, fallback = {})
  File.exist?(file) ? JSON.parse(File.read(file)) : fallback
rescue => error
  echo "LMAS: Unable to read #{file}: #{error.message}"
  fallback
end

def lmas_write_json(file, data)
  FileUtils.mkdir_p(File.dirname(file))
  File.open(file, 'w') { |f| f.write(JSON.pretty_generate(data)) }
rescue => error
  echo "LMAS: Unable to write #{file}: #{error.message}"
end

def lmas_default_global
  {
    "schema_version" => LMAS_SCHEMA_VERSION,
    "lmas_version" => LMAS_VERSION,
    "lmas_build" => LMAS_BUILD,
    "source" => {
      "lockpick_url" => "https://gswiki.play.net/Lockpick",
      "note" => "Static material data is seeded for LMAS sorting and can be refined as appraise text is collected."
    },
    "known_characters" => [],
    "static" => {
      "qualities" => LMAS_QUALITIES,
      "types" => LMAS_TYPES,
      "materials" => LMAS_MATERIALS,
      "workshop_reference" => LMAS_WORKSHOP_REFERENCE,
      "workshop_items" => {
        "wires" => LMAS_WIRE_ITEMS,
        "bars" => LMAS_BAR_ITEMS,
        "base_items" => LMAS_WORKSHOP_BASE_ITEMS,
        "keyrings" => LMAS_KEYRING_ITEMS
      },
      "conditions" => LMAS_CONDITIONS,
      "precision_scores" => LMAS_PRECISION_SCORES,
      "rank_requirements" => {
        "scan" => 24,
        "sort" => 24
      }
    }
  }
end

