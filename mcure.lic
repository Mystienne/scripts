# frozen_string_literal: true

=begin
  MCure - Mystienne's custom healing script for Gemstone IV
  Based on ECure by elanthia-online, enhanced with Mularos-themed roleplay.

  v1.1.0
    - Added --whisper flag: all sayings use whisper instead of say
    - Used by injurywatch when healing someone who accepted via whisper
=end

MULAROS_SAYINGS = [
	proc { |h, w| "#{w ? 'whisper' : 'say'} :reverent ::#{h} Mularos smiles upon this moment. Give me your wounds." },
	proc { |h, w| "#{w ? 'whisper' : 'say'} :prayerful ::#{h} I offer your suffering to Him gladly. Be still." },
	proc { |h, w| "#{w ? 'whisper' : 'say'} :solemn ::#{h} The Lord of Suffering has sent me. You need not ask why." },
	proc { |h, w| "#{w ? 'whisper' : 'say'} :serene ::#{h} Pain shared in His name is pain made holy. Come closer." },
	proc { |h, w| "#{w ? 'whisper' : 'say'} :reverent ::#{h} He brought you to me for a reason. I will not question His design." },
	proc { |h, w| "#{w ? 'whisper' : 'say'} :prayerful ::#{h} Let this be an act of devotion, #{h}. For Him, and for the hurt you carry." },
	proc { |h, w| "#{w ? 'whisper' : 'say'} :solemn ::#{h} I have been called to receive your suffering. It is an honor I do not take lightly." },
	proc { |h, w| "#{w ? 'whisper' : 'say'} :meditative ::#{h} Still your mind, #{h}. I need only a moment to reach for what torments you." },
	proc { |h, w| "#{w ? 'whisper' : 'say'} :seductive ::#{h} Your blood sings to me. Let me drink deeply of your hurt." },
	proc { |h, w| "#{w ? 'whisper' : 'say'} :inviting ::#{h} Every wound you carry is a gift I have not yet unwrapped." },
	proc { |h, w| "#{w ? 'whisper' : 'say'} :sensuous ::#{h} There is beauty in your suffering. I intend to carry it myself." },
	proc { |h, w| "#{w ? 'whisper' : 'say'} :enticing ::#{h} What delicious suffering you carry. Come. Let us trade." },
	proc { |h, w| "#{w ? 'whisper' : 'say'} :dark ::#{h} The darkness within me stirs at the sight of you. This pleases me." },
	proc { |h, w| "#{w ? 'whisper' : 'say'} :ominous ::#{h} I do not heal out of kindness. I heal because your pain belongs to me." },
	proc { |h, w| "#{w ? 'whisper' : 'say'} :cryptic ::#{h} Something within you called to me. I could not have ignored it if I tried." },
	proc { |h, w| "#{w ? 'whisper' : 'say'} :voracious ::#{h} The gift of pain is the sweetest offering. Come, let me take yours." },
	proc { |h, w| "#{w ? 'whisper' : 'say'} :hungry ::#{h} I have been waiting for something worth feeling. Come closer." },
	proc { |h, w| "#{w ? 'whisper' : 'say'} :sardonic ::#{h} I serve Mularos, and Mularos is merciful, in His own particular way." },
	proc { |h, w| "#{w ? 'whisper' : 'say'} :wry ::#{h} Your suffering calls to me like a prayer. I will answer it." },
	proc { |h, w| "#{w ? 'whisper' : 'say'} :tormented ::#{h} It pulls at me, your agony. I cannot let it go to waste." },
	proc { |h, w| "#{w ? 'whisper' : 'say'} :fervent ::#{h} He watches us now, #{h}. Let us not disappoint Him." },
	proc { |h, w| "#{w ? 'whisper' : 'say'} :longing ::#{h} I have carried the pain of so many. Yours feels different. I welcome that." },
	proc { |h, w| "#{w ? 'whisper' : 'say'} :calm ::#{h} You came to the right place. I will take good care of what ails you." },
	proc { |h, w| "#{w ? 'whisper' : 'say'} :intense ::#{h} Your suffering does not belong in you, #{h}. It belongs in me. Let me have it." },
	proc { |h, w| "#{w ? 'whisper' : 'say'} :tender ::#{h} Thank you for coming to me, #{h}. You could not have known how much I needed this." },
]

MULAROS_THANKS = [
	proc { |h, w| "#{w ? 'whisper' : 'say'} :reverent ::#{h} Your suffering was a worthy offering, #{h}. Mularos is pleased." },
	proc { |h, w| "#{w ? 'whisper' : 'say'} :prayerful ::#{h} I will carry what you gave me with gratitude, #{h}. He sees your gift." },
	proc { |h, w| "#{w ? 'whisper' : 'say'} :solemn ::#{h} What passed between us just now was sacred. Do not forget it." },
	proc { |h, w| "#{w ? 'whisper' : 'say'} :sensuous ::#{h} That was exquisite, #{h}. You are most generous with your pain." },
	proc { |h, w| "#{w ? 'whisper' : 'say'} :dark ::#{h} The darkness within me is quieter now, #{h}. You have done well." },
	proc { |h, w| "#{w ? 'whisper' : 'say'} :sardonic ::#{h} Most would say you owe me, #{h}. I would say we are even." },
	proc { |h, w| "#{w ? 'whisper' : 'say'} :wry ::#{h} A fair trade, #{h}. Your suffering for your wholeness. He approves." },
	proc { |h, w| "#{w ? 'whisper' : 'say'} :dry ::#{h} You are healed. I am nourished. I call that a success." },
	proc { |h, w| "#{w ? 'whisper' : 'say'} :fervent ::#{h} Every wound you gave me was a hymn. I am grateful, #{h}." },
	proc { |h, w| "#{w ? 'whisper' : 'say'} :tender ::#{h} You trusted me with your pain, #{h}. That is not nothing. Thank you." },
	proc { |h, w| "#{w ? 'whisper' : 'say'} :satisfied ::#{h} Mine now, #{h}. Every last bit of it. You are free." },
	proc { |h, w| "#{w ? 'whisper' : 'say'} :longing ::#{h} It passes so quickly. I am always a little bereft when it is over." },
]

MULAROS_OFFER_THANKS = [
	proc { |h, i, w| "#{w ? 'whisper' : 'say'} :reverent ::#{h} This #{i} is a worthy tribute, #{h}. Mularos smiles upon your generosity." },
	proc { |h, i, w| "#{w ? 'whisper' : 'say'} :prayerful ::#{h} I accept this #{i} in His name, #{h}. Your offering is noted." },
	proc { |h, i, w| "#{w ? 'whisper' : 'say'} :covetous ::#{h} This #{i} pleases me, #{h}. Almost as much as your wounds did." },
	proc { |h, i, w| "#{w ? 'whisper' : 'say'} :sardonic ::#{h} A #{i}. How fitting. Almost as precious as the pain you shared." },
	proc { |h, i, w| "#{w ? 'whisper' : 'say'} :tender ::#{h} This #{i} was not necessary, #{h}. But I am glad you offered it." },
]

def mularos_thank_healee(healee, whisper_mode = false)
	sleep rand(5..10)
	fput MULAROS_THANKS.sample.call(healee, whisper_mode)
end

MULAROS_SELF_THANKS = [
  proc { "say :satisfied Wounds taken, wounds healed. The cycle is its own reward." },
  proc { "say :rapturous That never gets old. The ache of it, the relief. I am grateful for both." },
  proc { "say :sensuous There is something almost meditative about carrying your own suffering for a time." },
  proc { "say :dark The wounds are gone. The memory of them is not. I prefer it that way." },
  proc { "say :sardonic One might call this suffering. I call it a Tuesday." },
  proc { "say :fervent Every wound I carry in His name is a prayer. Every healing, an answered one." },
  proc { "say :prayerful The suffering was His gift. The healing, my offering back. So it goes." },
  proc { "say :wistful Healed now. And already wondering when the next one will find me." },
  proc { "say :introspective There is a particular intimacy in knowing exactly how much you can endure." },
]

def mularos_self_thank
  sleep rand(3..8)
  fput MULAROS_SELF_THANKS.sample.call
end

# Whisper offer for injurywatch integration
MULAROS_WHISPER_OFFERS = [
  proc { |h| "whisper :serene ::#{h} I sense you carry wounds, #{h}. Shall I relieve you of them?" },
  proc { |h| "whisper :inviting ::#{h} Your suffering calls to me, #{h}. Would you allow me to take it?" },
  proc { |h| "whisper :solemn ::#{h} Mularos has drawn my attention to your wounds, #{h}. May I?" },
  proc { |h| "whisper :calm ::#{h} I am an empath who follows Mularos, #{h}. Would you like to be healed?" },
  proc { |h| "whisper :prayerful ::#{h} He has shown me your pain, #{h}. Will you let me carry it?" },
  proc { |h| "whisper :reverent ::#{h} Your wounds have not gone unnoticed, #{h}. Shall I ease them?" },
  proc { |h| "whisper :dark ::#{h} Something in you aches, #{h}. I would very much like to make it mine." },
  proc { |h| "whisper :hungry ::#{h} Your suffering is palpable, #{h}. Say the word and it becomes mine." },
  proc { |h| "whisper :wry ::#{h} You look as though you have had an interesting day, #{h}. Care for some relief?" },
  proc { |h| "whisper :tender ::#{h} I notice you are hurt, #{h}. Let me take that from you if you are willing." },
]

module MCure
  def self.debug?; CharSettings[:mcure_debug] ||= false; end
  def self.debug=(value); CharSettings[:mcure_debug] = value; Settings.save; end
  def self.debug_msg(msg); respond "[MCure DEBUG] #{msg}" if debug?; end

  class Configuration
    BODY_PARTS = %w[
      head neck abdomen back chest righteye lefteye
      rightleg leftleg rightarm leftarm righthand lefthand nerves
    ].freeze
    MODES = %w[heal hunt].freeze
    DEFAULT_LEVEL = 0

    def initialize(character_name)
      @character_name = character_name
      @settings = Settings[character_name] || {}
      load_defaults
    end

    attr_reader :settings

    def done_verb;              @settings['done_verb'] ||= '';        end
    def done_verb=(v);          @settings['done_verb'] = v;           end
    def use_signs?;             @settings['use_signs'] ||= false;     end
    def use_signs=(v);          @settings['use_signs'] = v;           end
    def alternative_behavior?;  @settings['alternative_behavior'] ||= false; end
    def alternative_behavior=(v);@settings['alternative_behavior'] = v;      end
    def use_trolls_blood?;      @settings['use_trolls_blood'] ||= Spell[1125].known?; end
    def use_trolls_blood=(v);   @settings['use_trolls_blood'] = v;   end
    def head_nerve_priority?;   @settings['head_nerve_priority'] ||= true;   end
    def head_nerve_priority=(v);@settings['head_nerve_priority'] = v;        end
    def mode;                   @settings['mode'] ||= 'heal';         end
    def mode=(v);               @settings['mode'] = v if MODES.include?(v);  end
    def all_wounds_level;       @settings['all_wounds_level'] ||= DEFAULT_LEVEL; end
    def all_wounds_level=(v);   @settings['all_wounds_level'] = v;   end
    def all_scars_level;        @settings['all_scars_level'] ||= DEFAULT_LEVEL; end
    def all_scars_level=(v);    @settings['all_scars_level'] = v;    end

    def wound_level(body_part, mode_type = nil)
      mode_type ||= mode
      [@settings["#{body_part}_wounds_#{mode_type}"] || DEFAULT_LEVEL, all_wounds_level].min
    end

    def scar_level(body_part, mode_type = nil)
      mode_type ||= mode
      [@settings["#{body_part}_scars_#{mode_type}"] || DEFAULT_LEVEL, all_scars_level].min
    end

    def set_wound_level(body_part, level, mode_type = nil)
      @settings["#{body_part}_wounds_#{mode_type || mode}"] = level
    end

    def set_scar_level(body_part, level, mode_type = nil)
      @settings["#{body_part}_scars_#{mode_type || mode}"] = level
    end

    def save; Settings[@character_name] = @settings; Settings.save; end

    private

    def load_defaults
      BODY_PARTS.each do |part|
        MODES.each do |m|
          @settings["#{part}_wounds_#{m}"] ||= DEFAULT_LEVEL
          @settings["#{part}_scars_#{m}"]  ||= DEFAULT_LEVEL
        end
      end
    end
  end

  class SpellManager
    CLOTTING_SPELL     = 9909
    STAUNCHING_SPELL   = 9905
    TROLLS_BLOOD_SPELL = 1125

    def initialize(config)
      @config = config
      @sign_spell = Spell[CLOTTING_SPELL].known? ? CLOTTING_SPELL :
                    Spell[STAUNCHING_SPELL].known? ? STAUNCHING_SPELL : nil
    end

    def check_signs
      return unless @sign_spell && @config.use_signs?
      return if Spell[@sign_spell].active?
      wait_until { Spell[@sign_spell].affordable? }
      Spell[@sign_spell].cast
    end

    def cast_trolls_blood
      return unless @config.use_trolls_blood?
      return if Spell[TROLLS_BLOOD_SPELL].active?
      wait_until { Spell[TROLLS_BLOOD_SPELL].affordable? }
      Spell[TROLLS_BLOOD_SPELL].cast
    end
  end

  class BodyPartManager
    @cached_mappings = {}
    BODY_PART_COSTS = {
      'head' => 4, 'nerves' => 3, 'neck' => 4,
      'chest' => 5, 'abdomen' => 5, 'back' => 5,
      'rightarm' => 2, 'leftarm' => 2, 'rightleg' => 2, 'leftleg' => 2,
      'righthand' => 2, 'lefthand' => 2, 'righteye' => 5, 'lefteye' => 5
    }.freeze
    LICH_NAME_MAPPING = {
      'head' => 'head', 'nerves' => 'nsys', 'neck' => 'neck',
      'chest' => 'chest', 'abdomen' => 'abs', 'back' => 'back',
      'rightarm' => 'rightArm', 'leftarm' => 'leftArm',
      'rightleg' => 'rightLeg', 'leftleg' => 'leftLeg',
      'righthand' => 'rightHand', 'lefthand' => 'leftHand',
      'righteye' => 'rightEye', 'lefteye' => 'leftEye'
    }.freeze
    def self.cost_for(p);             BODY_PART_COSTS[p] || 2;                               end
    def self.lich_name_for(p);        @cached_mappings[p] ||= LICH_NAME_MAPPING[p] || p;     end
    def self.format_name_for_command(p); p.gsub(/(right|left)(.*)/, '\1 \2');                end
    def self.critical_parts;          %w[head nerves];                                        end
  end

  class TargetAppraiser
    def initialize; @heal_target = nil; end
    attr_reader :heal_target

    def appraise(target_name)
      wounds = []
      @heal_target = nil
      3.times do |attempt|
        MCure.debug_msg("Appraising #{target_name} (attempt #{attempt + 1}/3)")
        waitrt?
        lines = Lich::Util.issue_command(
          "appraise #{target_name}",
          /You take a quick|Appraise what\?|^Usage:/,
          usexml: true, quiet: true, silent: true
        )
        lines.each do |line|
          case line
          when /^\s*You take a quick appraisal of <a exist="-\d+" noun=".*">(?<appraised_target>\w+)<\/a> and find that <a exist="-\d+" noun=".*">(?:he|she)<\/a> has (?<detected_wounds>..*)\./
            wounds.push(strip_xml(Regexp.last_match(:detected_wounds)))
            @heal_target = Regexp.last_match(:appraised_target)
          when /Appraise what\?|^Usage:/i
            wounds.push(line); @heal_target = target_name
          when /^\s*<a exist="-\d+" noun=".*">(?:He|She)<\/a> has (?<detected_scars>..*)\./
            wounds.push(Regexp.last_match(:detected_scars)) if Skills.mltransference >= 50
          when /^\s*<a exist="-\d+" noun=".*">(?:He|She)<\/a> appears to have <d cmd='transfer .+ exertion'>overexerted<\/d> (?:him|her)self\./
            wounds.push('overexerted')
          end
        end
        break unless @heal_target.nil?
      end
      wounds
    end

    def parse_wounds(wound_line)
      return [] if wound_line =~ /no apparent injuries|no apparent wounds\z/ && wound_line !~ /overexerted/
      wound_line = wound_line.gsub(/arm and/, "arm, ").gsub(/<d cmd.*?>/, "").gsub(/<\/d.*?>/, "")
      wound_array = wound_line.scan(/a (?:black-and-blue|severe bruises and swelling around|missing|blinded|swollen|bruised) (?:left|right) eye|old battle scars on (?:his|her) (?:left|right) (?:hand|arm|leg)|mangled (?:left|right) (?:hand|arm|leg)|missing (?:left|right) (?:hand|arm|leg)|deep lacerations across (?:his|her) \w+|deep gashes and serious bleeding (?:on|from|across) (?:his|her) \w+|minor cuts and bruises on (?:his|her) (?:left|right) (?:hand|arm|leg)|a (?:fractured and bleeding|completely severed) (?:left|right) (?:hand|arm|leg)|moderate bleeding from (?:his|her) neck|snapped bones and serious bleeding from the neck|minor bruises on (?:his|her) neck|scar across (?:his|her) neck|some old neck wounds|terrible scars from some serious neck injury|minor (?:bruises|lacerations) about the head|minor cuts and bruises on (?:his|her) (?:chest|back|abdominal(?: area)?)|severe head trauma and bleeding from the ears|strange case of muscle twitching|case of (?:sporadic|uncontrollable) convulsions|scar across (?:his|her) face|several facial scars|old mutilation wounds about (?:his|her) head|old battle scar across (?:his|her) (?:chest|back|abdominal(?: area)?)|several painful-looking scars across (?:his|her) (?:chest|back|abdominal(?: area)?)|terrible, permanent mutilation of (?:his|her) (?:chest|back|abdominal(?: area)?) muscles|developed slurred speech|constant muscle spasms|a very difficult time with muscle control|overexerted/)
      body_parts = []
      wound_array.each do |wound|
        case wound
        when /(?:an? )?(?:black-and-blue|severe bruises and swelling around|blinded|mangled|swollen|bruised|missing|deep lacerations across his|deep lacerations across her|cuts and bruises on his|cuts and bruises on her|fractured and bleeding|completely severed|deep gashes and serious bleeding on his|deep gashes and serious bleeding on her|deep gashes and serious bleeding from his|deep gashes and serious bleeding from her|old battle scars on his|old battle scars on her|old battle scar across (?:his|her)|several painful-looking scars across (?:his|her)|terrible, permanent mutilation of (?:his|her)) (?<rightleft>\w+)(?<bodypart> \w+)?/
          body_parts << "#{Regexp.last_match(:rightleft).strip} #{Regexp.last_match(:bodypart).strip}".strip
        when /moderate bleeding from (his|her) neck|snapped bones and serious bleeding from the neck|minor bruises on (his|her) neck|scar across (?:his|her) neck|some old neck wounds|terrible scars from some serious neck injury/
          body_parts << "neck"
        when /minor bruises about the head|minor lacerations about the head|severe head trauma and bleeding from the ears|scar across (?:his|her) face|several facial scars|old mutilation wounds about (?:his|her) head/
          body_parts << "head"
        when /strange case of muscle twitching|case of sporadic convulsions|case of uncontrollable convulsions|developed slurred speech|constant muscle spasms|a very difficult time with muscle control/
          body_parts << "nerves"
        when /overexerted/
          body_parts << "exertion"
        end
      end
      body_parts
    end

    private
    def strip_xml(str); str.to_s.gsub(/<[^>]+>/, '').gsub(/\s+/, ' ').strip; end
  end

  class HealingEngine
    def initialize(config, spell_manager, whisper_mode: false)
      @config        = config
      @spell_manager = spell_manager
      @appraiser     = TargetAppraiser.new
      @whisper_mode  = whisper_mode
    end

    def execute_healing_command(command, required_mana = nil)
      attempt_with_hindrance_retry do |attempt, max_attempts|
        wait_for_mana(required_mana) if required_mana
        waitrt?; waitcastrt?
        dothistimeout(command, 2, /^\[Spell Hindrance|^Cast/)
      end
    end

    def heal_exertion
      attempt_with_hindrance_retry do
        wait_for_mana(7); waitrt?; waitcastrt?
        Spell[1107].force_incant
      end
    end

    def heal_self
      heal_exertion if Effects::Debuffs.active?("Overexerted")
      @spell_manager.cast_trolls_blood
      3.downto(0) { |l| BodyPartManager::BODY_PART_COSTS.keys.each { |p| heal_wound_if_needed(p, l) } }
      3.downto(0) { |l| BodyPartManager::BODY_PART_COSTS.keys.each { |p| heal_scar_if_needed(p, l) } }
      restore_health
      perform_completion_action
      Thread.new { mularos_self_thank }
    end

    def heal_target(target_name, whisper_mode: @whisper_mode)
      wounds = @appraiser.appraise(target_name)
      if wounds.empty? || wounds.first =~ /Appraise what|Usage/
        respond("Couldn't find or no injuries on #{target_name}!")
        return
      end
      wound_line = wounds.join(", ")
      if wound_line =~ /no apparent injuries|no apparent wounds\z/ && wound_line !~ /overexerted/
        respond("#{@appraiser.heal_target} does not appear to be injured.")
        return
      end
      fput MULAROS_SAYINGS.sample.call(@appraiser.heal_target, whisper_mode)
      heal_target_wounds(wound_line)
      healed_name = @appraiser.heal_target
      Thread.new { mularos_thank_healee(healed_name, whisper_mode) }
    end

    def heal_group
      get_group_members.each { |m| heal_target(m) }
    end

    def heal_room
      GameObj.pcs.map(&:noun).each { |pc| heal_target(pc) }
    end

    private

    def attempt_with_hindrance_retry(max_attempts: 3)
      attempt = 1
      loop do
        result = yield attempt, max_attempts
        case result
        when /^Cast/ then break
        when /^\[Spell/
          attempt += 1
          break if attempt > max_attempts
          sleep(1 + attempt)
        else
          attempt += 1
          attempt < max_attempts ? sleep(1) : break
        end
      end
      sleep(0.5); waitcastrt?; waitrt?
    end

    def heal_wound_if_needed(part, level)
      lich_name     = BodyPartManager.lich_name_for(part)
      current_level = Wounds.send(lich_name)
      target_level  = @config.wound_level(part)
      return unless current_level == level && current_level > target_level
      handle_critical_parts(part) if BodyPartManager.critical_parts.include?(part) && @config.head_nerve_priority?
      heal_body_part(part, current_level > 1)
    end

    def heal_scar_if_needed(part, level)
      lich_name           = BodyPartManager.lich_name_for(part)
      current_scar_level  = Scars.send(lich_name)
      current_wound_level = Wounds.send(lich_name)
      target_level        = @config.scar_level(part)
      return unless current_scar_level == level && current_wound_level == 0 && current_scar_level > target_level
      heal_body_part(part, current_scar_level > 1, true)
    end

    def heal_body_part(part, severe_injury = false, is_scar = false)
      @spell_manager.check_signs
      restore_health
      mana_cost      = BodyPartManager.cost_for(part) + (severe_injury ? 5 : 0) + (is_scar ? 9 : 0)
      formatted_part = BodyPartManager.format_name_for_command(part)
      execute_healing_command("cure #{formatted_part}", mana_cost)
    end

    def wait_for_mana(required_mana)
      return if Char.mana >= required_mana
      respond("Waiting for mana...")
      sleep(1) until Char.mana >= required_mana
    end

    def restore_health
      while Char.percent_health < 90
        execute_healing_command("cure blood", 1)
      end
    end

    def handle_critical_parts(part)
      heal_to_scar_level(part, 1)
    end

    def heal_to_scar_level(part, target_level)
      lich_name = BodyPartManager.lich_name_for(part)
      while Scars.send(lich_name) > target_level
        while Wounds.send(lich_name) > 0
          heal_body_part(part, Wounds.send(lich_name) > 1)
        end
        heal_body_part(part, false, true)
      end
    end

    def heal_target_wounds(wound_line)
      body_parts = @appraiser.parse_wounds(wound_line)
      return if body_parts.empty?
      @spell_manager.check_signs
      body_parts.each { |part| transfer_wound(part) }
      pre_health = Char.health; post_health = 0; total_healed = 0
      until pre_health == post_health
        if Char.health <= 75 || Char.percent_health < 51
          restore_health; next
        end
        pre_health = Char.health
        fput("transfer #{@appraiser.heal_target}")
        post_health = Char.health
        total_healed += (pre_health - post_health)
      end
      if total_healed > 0
        respond "You healed #{@appraiser.heal_target} of #{wound_line} along with #{total_healed} hitpoints."
      else
        respond "You healed #{@appraiser.heal_target} of #{wound_line}."
      end
      restore_health
    end

    def transfer_wound(part)
      case part
      when /^(left|right) (arm|hand|leg|eye)$/
        heal_body_part(part.gsub(' ', '')) if Wounds.send(BodyPartManager.lich_name_for(part.gsub(' ', ''))) == 3
        fput("transfer #{@appraiser.heal_target} #{part}")
      when /abdom/
        heal_body_part('abdomen') if Wounds.abs == 3
        fput("transfer #{@appraiser.heal_target} abdomen"); sleep(1)
      when 'nerves'
        heal_body_part('nerves') if Wounds.nsys == 3
        fput("transfer #{@appraiser.heal_target} nerves"); sleep(1)
      when 'head', 'neck', 'chest', 'back'
        heal_body_part(part) if Wounds.send(part) == 3
        fput("transfer #{@appraiser.heal_target} #{part}")
      when 'exertion'
        heal_exertion if Effects::Debuffs.active?("Overexerted")
        fput("transfer #{@appraiser.heal_target} #{part}")
      end
    end

    def get_group_members
      Lich::Util.issue_command("group", /^You are/, /GROUP HELP/, usexml: false, quiet: true, silent: true)
      Group.nouns
    end

    def perform_completion_action
      return if @config.done_verb.nil? || @config.done_verb.empty?
      fput @config.done_verb
    end
  end

  class Application
    def initialize
      validate_character_profession
      @config        = Configuration.new(Char.name)
      @spell_manager = SpellManager.new(@config)
    end

    def run(args = [])
      return toggle_debug       if args.include?('--debug')
      return show_settings_list if args.include?('--list')
      return show_configuration if args.first =~ /^setup$|^options$/i
      return show_help          if args.include?('help')

      whisper_mode   = args.delete('--whisper') || false
      healing_engine = MCure::HealingEngine.new(@config, @spell_manager, whisper_mode: whisper_mode)

      process_arguments(args)
      action = determine_action(args, healing_engine)

      case action
      when :heal_self
        healing_engine.heal_self
      when :heal_targets
        find_target_players(args).each { |t| healing_engine.heal_target(t) }
        healing_engine.heal_self
      when :heal_group
        healing_engine.heal_group
        healing_engine.heal_self
      when :heal_room
        healing_engine.heal_room
        healing_engine.heal_self
      end

      exit if @config.alternative_behavior? && args.any?
    end

    private

    def toggle_debug
      MCure.debug = !MCure.debug?
      respond "MCure debug mode: #{MCure.debug? ? 'ON' : 'OFF'}"
      exit
    end

    def show_settings_list
      w = 16
      respond "=[ MCure Settings: #{Char.name} ]="
      respond "#{'Mode'.ljust(w)}: #{@config.mode}"
      respond "#{'Done Verb'.ljust(w)}: #{@config.done_verb.empty? ? '(none)' : @config.done_verb}"
      respond "#{'Use Signs'.ljust(w)}: #{@config.use_signs?}"
      respond "#{"Troll's Blood".ljust(w)}: #{@config.use_trolls_blood?}"
      respond "#{'Alt Behavior'.ljust(w)}: #{@config.alternative_behavior?}"
      respond "#{'Head/Nerve Pri.'.ljust(w)}: #{@config.head_nerve_priority?}"
      respond "#{'All Wounds Lvl'.ljust(w)}: #{@config.all_wounds_level}"
      respond "#{'All Scars Lvl'.ljust(w)}: #{@config.all_scars_level}"
      Configuration::BODY_PARTS.each { |p| respond "#{p.ljust(12)}  #{@config.wound_level(p).to_s.ljust(6)}  #{@config.scar_level(p)}" }
      exit
    end

    def show_configuration
      gui = MCure::ConfigurationGUI.new(@config)
      gui.show
      exit
    end

    def show_help
      respond "MCure - Mystienne's custom healing script"
      respond "  mcure              - Heal yourself"
      respond "  mcure setup        - Open configuration GUI"
      respond "  mcure <names>      - Heal specific targets"
      respond "  mcure group        - Heal group members"
      respond "  mcure room         - Heal everyone in room"
      respond "  mcure all          - Heal completely"
      respond "  mcure hunt/heal    - Switch active mode"
      respond "  mcure --whisper    - Use whisper mode for sayings"
      respond "  mcure --list       - Show current settings"
      respond "  mcure --debug      - Toggle debug output"
      exit
    end

    def process_arguments(args)
      if args.include?("all")
        @config.all_wounds_level = 0
        @config.all_scars_level  = 0
        args.delete("all")
      end
      @config.mode = 'hunt' if args.first =~ /^hunt$/i
      @config.mode = 'heal' if args.first =~ /^heal$/i
    end

    def determine_action(args, _engine)
      return :heal_room    if args.include?('room')
      return :heal_group   if args.include?('group')
      return :heal_targets if find_target_players(args).any?
      :heal_self
    end

    def find_target_players(args)
      return [] unless GameObj.pcs&.any?
      reserved = %w[hunt heal group room all setup options help --list --debug --whisper]
      targets = []; failed = []
      args.each do |input|
        next if reserved.include?(input.downcase)
        pc = GameObj.pcs.find { |p| p.noun =~ /^#{input}/i }
        pc ? targets << pc.noun : failed << input
      end
      respond("Could not find: #{failed.join(', ')}") if failed.any?
      targets
    end

    def validate_character_profession
      return if Stats.prof == 'Empath'
      respond "Nice try, non-empath person!"
      exit
    end
  end

  class ConfigurationGUI
    def initialize(config)
      @config = config
      @window = nil
      @window_action = nil
    end

    def show
      Gtk.queue do
        @window = Gtk::Window.new
        @window.title = "MCure Configuration"
        @window.border_width = 10
        @window.signal_connect('delete_event') { @window_action = :cancel }
        notebook = Gtk::Notebook.new
        notebook.append_page(create_simple_tab,  Gtk::Label.new("Basic Setup"))
        notebook.append_page(create_body_part_tab('hunt'), Gtk::Label.new("Hunting Setup"))
        notebook.append_page(create_body_part_tab('heal'), Gtk::Label.new("Healing Setup"))
        table = Gtk::Table.new(2, 1, false)
        table.attach(notebook, 0, 1, 0, 1)
        save_btn = Gtk::Button.new(label: 'Save')
        save_btn.signal_connect('clicked') { respond("-=[ Settings Saved ]=-"); @window_action = :save }
        table.attach(save_btn, 0, 1, 1, 2)
        @window.add(table)
        @window.show_all
      end
      before_dying { Gtk.queue { @window&.destroy } }
      wait_while { @window_action.nil? }
      undo_before_dying
      Gtk.queue { @window&.destroy }
      @config.save if @window_action == :save
    end

    private

    def create_simple_tab
      t = Gtk::Table.new(5, 4, false); t.border_width = 3
      t.attach(Gtk::Label.new("Wounds:"), 0, 1, 0, 1, :shrink, :shrink, 2, 1)
      t.attach(spin_for_all(:wounds), 1, 2, 0, 1, :shrink, :shrink, 8, 1)
      t.attach(Gtk::Label.new("Scars:"), 2, 3, 0, 1, :shrink, :shrink, 2, 1)
      t.attach(spin_for_all(:scars), 3, 4, 0, 1, :shrink, :shrink, 2, 1)
      mb = mode_btn; mb.set_size_request(200, -1)
      t.attach(mb, 0, 4, 1, 2, :shrink, :shrink, 2, 2)
      [
        ["Head/Nerve Priority", :head_nerve_priority?,  method(:set_hnp),  0, 2],
        ["Use Troll's Blood",   :use_trolls_blood?,     method(:set_tb),   2, 4],
        ["Alt Behavior",        :alternative_behavior?, method(:set_ab),   0, 2],
        ["Use Signs",           :use_signs?,            method(:set_us),   2, 4],
      ].each_with_index do |(lbl, getter, setter, c1, c2), i|
        cb = Gtk::CheckButton.new(lbl)
        cb.set_active(@config.send(getter))
        cb.signal_connect("clicked") { setter.call(cb.active?) }
        t.attach(cb, c1, c2, 2 + (i / 2), 3 + (i / 2), :shrink, :shrink, 2, 1)
      end
      dv_box = Gtk::Box.new(:horizontal, 5)
      dv_box.pack_start(Gtk::Label.new("Done:"), expand: false, fill: false, padding: 0)
      dv = Gtk::Entry.new; dv.set_text(@config.done_verb)
      dv.signal_connect("changed") { @config.done_verb = dv.text }
      dv.set_size_request(120, -1)
      dv_box.pack_start(dv, expand: false, fill: false, padding: 0)
      t.attach(dv_box, 0, 4, 4, 5, :shrink, :shrink, 2, 1)
      t
    end

    def spin_for_all(type)
      cur = type == :wounds ? @config.all_wounds_level : @config.all_scars_level
      s = Gtk::SpinButton.new(0, 3, 1); s.value = cur.to_f
      s.signal_connect("value_changed") {
        type == :wounds ? @config.all_wounds_level = s.value.to_i : @config.all_scars_level = s.value.to_i
      }
      s
    end

    def mode_btn
      lbl = ->(m) { m == 'heal' ? 'Healing Mode Selected' : 'Hunting Mode Selected' }
      b = Gtk::Button.new(label: lbl.call(@config.mode))
      b.signal_connect('clicked') { @config.mode = @config.mode == 'heal' ? 'hunt' : 'heal'; b.label = lbl.call(@config.mode) }
      b
    end

    def set_hnp(v);  @config.head_nerve_priority  = v; end
    def set_tb(v);   @config.use_trolls_blood     = v; end
    def set_ab(v);   @config.alternative_behavior = v; end
    def set_us(v);   @config.use_signs            = v; end

    def create_body_part_tab(mode_type)
      box = Gtk::Box.new(:vertical, 2); box.border_width = 3
      box.pack_start(Gtk::Label.new("#{mode_type.capitalize}: 3=ignore, 0=heal completely"), expand: false, fill: false, padding: 1)
      row = Gtk::Box.new(:horizontal, 5)
      wf = Gtk::Frame.new("Wounds"); wf.add(part_grid(:wounds, mode_type)); row.pack_start(wf, expand: false, fill: false, padding: 2)
      sf = Gtk::Frame.new("Scars");  sf.add(part_grid(:scars,  mode_type)); row.pack_start(sf, expand: false, fill: false, padding: 2)
      box.pack_start(row, expand: false, fill: false, padding: 0)
      box
    end

    def part_grid(injury_type, mode_type)
      t = Gtk::Table.new(7, 2, false); t.border_width = 2
      core = [['Head','head'],['Neck','neck'],['Chest','chest'],['Abdomen','abdomen'],['Back','back'],['Nerves','nerves']]
      limbs = [['R.Arm','rightarm'],['L.Arm','leftarm'],['R.Hand','righthand'],['L.Hand','lefthand'],['R.Leg','rightleg'],['L.Leg','leftleg'],['R.Eye','righteye'],['L.Eye','lefteye']]
      row = 0
      core.each do |dn, part|
        lbl = Gtk::Label.new("#{dn}:"); lbl.set_alignment(0.0, 0.5); lbl.set_size_request(50, -1)
        t.attach(lbl, 0, 1, row, row+1, :shrink, :shrink, 1, 1)
        t.attach(part_spin(part, injury_type, mode_type), 1, 2, row, row+1, :shrink, :shrink, 1, 1)
        row += 1
      end
      t.attach(Gtk::HSeparator.new, 0, 2, row, row+1, :fill, :shrink, 0, 1); row += 1
      lt = Gtk::Table.new(4, 4, false); lr = 0; lc = 0
      limbs.each do |dn, part|
        b = Gtk::Box.new(:horizontal, 1)
        l = Gtk::Label.new(dn); l.set_size_request(30, -1)
        s = part_spin(part, injury_type, mode_type); s.set_size_request(40, -1)
        b.pack_start(l, expand: false, fill: false, padding: 0)
        b.pack_start(s, expand: false, fill: false, padding: 0)
        lt.attach(b, lc, lc+1, lr, lr+1, :shrink, :shrink, 1, 1)
        lc += 1; lc, lr = 0, lr+1 if lc >= 2
      end
      t.attach(lt, 0, 2, row, row+1, :shrink, :shrink, 0, 0)
      t
    end

    def part_spin(part, injury_type, mode_type)
      cur = injury_type == :wounds ? @config.wound_level(part, mode_type) : @config.scar_level(part, mode_type)
      s = Gtk::SpinButton.new(0, 3, 1); s.value = cur.to_f; s.set_size_request(50, -1)
      s.signal_connect("value_changed") {
        injury_type == :wounds ? @config.set_wound_level(part, s.value.to_i, mode_type)
                               : @config.set_scar_level(part, s.value.to_i, mode_type)
      }
      s
    end
  end
end

silence_me
before_dying { DownstreamHook.remove("Appraising") }
mcure_app = MCure::Application.new
mcure_app.run(Script.current.vars[1..-1])
