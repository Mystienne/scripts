	proc { |h| "say :tormented ::#{h} I have ached for this all day, #{h}. You have no idea what a relief you are." },
	proc { |h| "say :fervent ::#{h} There is no act more sacred than this. The giving of pain to one who craves it." },
	proc { |h| "say :passionate ::#{h} I would carry every wound in this city if I could. Yours will do for now." },
	proc { |h| "say :rapturous ::#{h} The moment your hurt passes into me is the only peace I know." },
