def mularos_speak_and_nod(healee, whisper = false)
	fput "nod #{healee}"
	# Watch for ~2s after our nod to catch near-simultaneous nods from other healers
	rival = matchtimeout 2, "nods at #{healee}", "nods to #{healee}", "focuses on #{healee} with intense concentration"
	if rival && rival =~ /([A-Z][a-z]+) (?:nods|focuses)/
		rival_name = $1
		if rival_name != Char.name
			echo "***** #{rival_name} also nodded at #{healee} just after us, stepping back. *****"
			return false
		end
	end
	sleep rand(3..7)
	saying = MULAROS_SAYINGS.sample.call(healee)
	if whisper
		# Convert "say :{tone} ::{target} {message}" to "whisper :{tone} {healee}, {message}"
		if saying =~ /^say (:.+?) ::#{healee} (.+)$/
			fput "whisper #{$1} #{healee}, #{$2}"
		else
			fput saying.sub(/^say /, "whisper #{healee}, ")
		end
	else
		fput saying
	end
	return true
end

# -- Post-heal thank you sayings (5-10s after healing completes) --
