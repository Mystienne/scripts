	proc { |h| "say :longing ::#{h} Go well, #{h}. And know that what you gave will be remembered fondly." },
	proc { |h| "say :tender ::#{h} I carry it now. You do not have to anymore. That is how it should be." },
	proc { |h| "say :warm ::#{h} You came to the right person, #{h}. I hope you know that." },

	# -- possessive / satisfied --
	proc { |h| "say :satisfied ::#{h} Mine now, #{h}. Every last bit of it. You are free." },
	proc { |h| "say :obsessive ::#{h} I always remember the ones who give willingly. I will remember you." },
	proc { |h| "say :intense ::#{h} That is what I needed today. I hope you needed it too." },
	proc { |h| "say :compulsive ::#{h} I could not have walked away from that if I tried. Thank you for not making me." },
	proc { |h| "say :pleased ::#{h} You have no idea how long I waited for something like that. Thank you, #{h}." },
]

# -- Item offering thank you sayings (5-10s after stowing the item) --
MULAROS_OFFER_THANKS = [
	# -- reverent / gracious --
	proc { |h, i| "say :reverent ::#{h} This #{i} is a worthy tribute, #{h}. Mularos smiles upon your generosity." },
	proc { |h, i| "say :prayerful ::#{h} I accept this #{i} in His name, #{h}. Your offering is noted." },
	proc { |h, i| "say :gracious ::#{h} You honor me with this #{i}, #{h}. It will be treasured." },
	proc { |h, i| "say :solemn ::#{h} This #{i} shall remind me of your gift, #{h}. I am grateful." },
	proc { |h, i| "say :reverent ::#{h} A #{i} and your suffering both in one day, #{h}. You are uncommonly generous." },
	proc { |h, i| "say :prayerful ::#{h} He sees this #{i} as clearly as He saw your wounds. Both are offerings." },

	# -- dark / covetous --
	proc { |h, i| "say :covetous ::#{h} This #{i} pleases me, #{h}. Almost as much as your wounds did." },
	proc { |h, i| "say :dark ::#{h} A fitting tribute, #{h}. The darkness within me stirs with approval." },
	proc { |h, i| "say :ominous ::#{h} This #{i} is mine now, #{h}. As your suffering was. Thank you." },
	proc { |h, i| "say :cryptic ::#{h} I sense meaning in this #{i}, #{h}. He intended you to give it." },
	proc { |h, i| "say :covetous ::#{h} I have wanted many things in my life. This #{i} was not among them. And yet I find I want it now." },
	proc { |h, i| "say :dark ::#{h} Objects carry the energy of those who held them. This #{i} will carry yours, #{h}." },
	proc { |h, i| "say :ominous ::#{h} A curious choice of gift, #{h}. I like that about you." },

	# -- sensuous / savoring --
	proc { |h, i| "say :sensuous ::#{h} How thoughtful, #{h}. This #{i} is as lovely as your pain was." },
	proc { |h, i| "say :seductive ::#{h} You bring me gifts, #{h}. You understand me better than most." },
	proc { |h, i| "say :lusty ::#{h} First your wounds, now a #{i}. You are dangerously generous, #{h}." },
	proc { |h, i| "say :sensuous ::#{h} A #{i} after suffering shared. You know how to make an impression, #{h}." },
	proc { |h, i| "say :enticing ::#{h} This #{i} and the memory of your pain. You have given me two gifts today." },

	# -- wry / sardonic --
	proc { |h, i| "say :sardonic ::#{h} A #{i}. How fitting. Almost as precious as the pain you shared." },
	proc { |h, i| "say :wry ::#{h} You need not have brought a #{i}, #{h}. And yet I am glad you did." },
	proc { |h, i| "say :dry ::#{h} A #{i}. My thanks, #{h}. You may go be whole somewhere else now." },
	proc { |h, i| "say :sly ::#{h} Offerings accepted, #{h}. Come back broken again sometime." },
	proc { |h, i| "say :sardonic ::#{h} Most people offer coin. You offer a #{i}. I think I prefer you, #{h}." },
	proc { |h, i| "say :wry ::#{h} I did not expect a #{i} today. The day has exceeded expectations." },
	proc { |h, i| "say :droll ::#{h} A #{i}. From someone who just gave me their wounds. You are thorough, #{h}." },

	# -- tender / warm --
	proc { |h, i| "say :tender ::#{h} This #{i} was not necessary, #{h}. But I am glad you offered it." },
	proc { |h, i| "say :warm ::#{h} You came to me hurting and left me a #{i} as well. That means something." },
	proc { |h, i| "say :tender ::#{h} I will keep this #{i} close, #{h}. It will remind me of what we shared." },
	proc { |h, i| "say :grateful ::#{h} The #{i} is appreciated. But it was your trust that mattered most today." },

	# -- fervent / intense --
	proc { |h, i| "say :fervent ::#{h} This #{i} joins the pain you gave me as an offering. Both are received." },
	proc { |h, i| "say :passionate ::#{h} You gave me your hurt and now a #{i}. I am twice blessed today, #{h}." },
	proc { |h, i| "say :intense ::#{h} Do not give #{i}s to everyone who heals you, #{h}. Save them for those who mean it." },
	proc { |h, i| "say :obsessive ::#{h} A #{i} from #{h}. I will not forget where this came from." },
	proc { |h, i| "say :compulsive ::#{h} I accepted before I even thought about it. The #{i} called to me as clearly as your wounds did." },
]

def mularos_thank_healee(healee)
	sleep rand(5..10)
	fput MULAROS_THANKS.sample.call(healee)
end

# Background thread watching for item offers
Thread.new {
	loop {
		offer_line = matchtimeout 30, "offers you"
		next unless offer_line
		if offer_line =~ /^([A-Z][a-z]+) offers you an? (.+?)\./
			giver = $1
			item  = $2
			echo "*** #{giver} is offering you a #{item}, will accept shortly ***"
			sleep rand(3..15)
			result = dothistimeout "accept #{giver}", 5, /You accept|There is no offer/
			if result =~ /You accept/
				echo "*** Accepted #{item} from #{giver}, stowing ***"
				waitrt?
				fput "stow #{item}"
				sleep rand(5..10)
				fput MULAROS_OFFER_THANKS.sample.call(giver, item)
			else
				echo "*** Offer from #{giver} expired or was not found ***"
			end
		end
	}
}

def AnyOtherEmpaths?()
	return GameObj.pcs.any? { |pc| 
		pc.noun != Char.name && !CharSettings['known_empaths'][pc.noun].nil?
	}
end

############################################################################################################
echo "***HealBot knows about #{CharSettings['known_empaths'].length} empaths.***"
scan_for_empaths.call
$lastScan = Time.now 

loop {
	#scan for new empaths every 5 minutes
	if Time.now - $lastScan > 300
		scan_for_empaths.call
		$lastScan = Time.now 
	end

	#keep staunching up in case you accept bleeders
	fput "sign of staunching" if Spell["Sign of Staunching"].known? && Spell["Sign of Staunching"].affordable? && !Spell["Sign of Staunching"].active?
	
	#echo "waiting for healee.."
	line = matchtimeout 10, "whispers", "asks", "exclaims", "says", "just", "arrived", "arrives", "taps you", "shatters into thousands of fragments", "severely perforated", "drawing the blood from his body", "begins to boil violently", "sickly greenish hue"
	#next if checkmind !~ /becoming|muddled|clear|fresh|numbed/
#You infuse Fliayeb with your own strength, and she appears entirely restored
if line
	if line =~ /(?:^Speaking .*to you.*)?((?:The ghostly voice of |The ghost of )?([A-Z][a-z]+)(?:\s+\w+)?\s+(whispers,|asks,|exclaims,|says,))(?i).*?(heal[^t]|healer|bleed|minor|'?ealing?|lacerations|cuts|wound|patch|empath|poison|disease|medic|moment|spare|hurt|injured|injuries)|([A-Z][a-z]+) meditates over.*/i
		healee = $2 || $5   # $2 from speech match, $5 from meditates match
		verb = $3

		if line =~ /Speaking .*to/
			next unless line =~ /Speaking .*to you/
		end

		next if ignore.include? healee
		next if healee =~ /Speaking/

		bodies = GameObj.pcs.select { |pc| pc.status =~ /dead/ }.map{ |pc| pc.name }
		has_bodies = bodies.length > 0
		bodies_regex = /(#{bodies.join('|')})/

		pause_script "bigshot" if running? 'bigshot'
		echo "***** Healing requested by #{healee}... *****"
		if !CharSettings["known_empaths"][healee].nil? || healee =~ KnownEmpaths 
			echo "*** #{healee} is an empath ***"
			next
		end
		
		#default wait time
		waittime = 6
		sleeptime = 3

		if percentmind <= 25 #you need xp
			waittime = 2
			sleeptime = 1
			echo "*** Mind low, moving quickly on #{healee} ***"
		end
		if percentmind > 70 #give other healers a chance
			if !AnyOtherEmpaths?()
				echo "*** There seem to be no other empaths, so we won't wait extra long ***"
			else
				waittime = 24
				echo "*** Mind high, waiting longer to see if #{healee} gets healed.. ***"
			end
		end

		if $invasion
			waittime = 3
			echo "*** It's an invasion, we'll move quickly ***"
		end
		
		if verb =~ /whispers/
			echo "*** Direct whisper, expediting ***"
			sleeptime = 1
			waittime = 1
		end
		is_whisper = (verb =~ /whispers/) ? true : false

		result = matchtimeout waittime + checkrt, "nods at #{healee}", "nods to #{healee}", "focuses on #{healee} with intense concentration"
		if result
		if result =~ /(.*) nods at|(.*) focuses on #{healee} with intense concentration/ #some other healer is working this target
			echo "***** Looks like #{$1} is healing #{healee}. ******"
			next
		end
		end
		echo "***** We will heal #{healee}. ******"

		#appraisal check
		result = dothistimeout "appraise #{healee}", 5, /You take a quick appraisal/
		if result =~ /no apparent injuries/
			echo "***** #{healee} is not injured.  False alarm? *****"
			if has_bodies && line =~ bodies_regex
				next if $1.nil?
				echo "*** Maybe they are talking about the dead body, #{$1} ***"
				deader = $1
				result = dothistimeout "appraise #{deader}", 5, /You take a quick appraisal/
				if result =~ /no apparent injuries/
					echo "*** The dead body has no injuries. ***"
					next
				else
					next unless mularos_speak_and_nod(deader, is_whisper)
					healee = deader
				end
			else
				next
			end
		else
			next unless mularos_speak_and_nod(healee, is_whisper)
		end
		gd_wound_transfer(healee)
		Thread.new { mularos_thank_healee(healee) }
	elsif line =~ /([A-Z,a-z]+)('s group | )(just arrived|arrives at your table|just came crawling in|just limped in|just came marching in|just came sashaying in gracefully|just arrived, skipping merrily|just tiptoed in|just strode in|just stumbled in|just came trudging in)/
		healee = $1
		if friendlist.include?(healee)
			echo "Friend #{$1} arrived."	
			gd_wound_transfer(healee)
			Thread.new { mularos_thank_healee(healee) }
		end
	elsif line =~ /([A-Z,a-z]+) taps you lightly on the shoulder/
		healee = $1
		echo "Direct tap."
		sleep 2
		next unless mularos_speak_and_nod(healee)
		gd_wound_transfer(healee)
		Thread.new { mularos_thank_healee(healee) }
	elsif line =~ /which quickly shatters into thousands of fragments/
		line =~ /(.*)'s voice focuses on the (.*) which quickly shatters into thousands of fragments/
		healee = $1
		echo "Uh oh bard accident."
		gd_wound_transfer(healee)
	elsif line =~ /(.*) is severely perforated|The ground beneath (.*) begins to boil violently/
		healee = $1
		echo "Uh oh rogue accident."
		gd_wound_transfer(healee)
	elsif line =~ /\. (.*) looks ill as (?:his|her) skin takes on a sickly greenish hue/
		healee = $1
		echo "Uh oh scarab poison."
		Spell[114].cast healee
		gd_wound_transfer(healee)
	elsif line =~ /\. (.*?) moans to himself and his skin takes on a yellowish tint./
		healee = $1
		echo "Uh oh scarab disease"
		Spell[113].cast healee
	elsif line =~ /(.*) gasps in pain and shock as (.*) drawing the blood from his body/
		healee = $1
		echo "Uh oh blood scarab."
		10.times {
			fput "transfer #{$1}"
			fput "cure blood"
			sleep 3
		}
	end
	end
	healbot_healme("Wounds", 3)
	healbot_healme("Scars", 3)
}

#Tavino gasps in pain and shock as a blood red teardrop-etched scarab pulsates, drawing the blood from his body!