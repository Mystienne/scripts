	# -- reverent / grateful --
	proc { |h| "say :reverent ::#{h} Your suffering was a worthy offering, #{h}. Mularos is pleased." },
	proc { |h| "say :prayerful ::#{h} I will carry what you gave me with gratitude, #{h}. He sees your gift." },
	proc { |h| "say :solemn ::#{h} What passed between us just now was sacred. Do not forget it." },
	proc { |h| "say :serene ::#{h} The exchange is complete. I am satisfied. Thank you, #{h}." },
	proc { |h| "say :reverent ::#{h} He witnessed this. I am certain of it. Thank you for the offering, #{h}." },
	proc { |h| "say :prayerful ::#{h} The pain you gave has been received with all the reverence it deserved." },
	proc { |h| "say :solemn ::#{h} I will not forget what you gave me today, #{h}. It meant more than you know." },

	# -- sensuous / savoring --
	proc { |h| "say :sensuous ::#{h} That was exquisite, #{h}. You are most generous with your pain." },
	proc { |h| "say :rapturous ::#{h} Mmm. You gave more than I expected. I am grateful, #{h}." },
	proc { |h| "say :lusty ::#{h} Your wounds tasted of something rare, #{h}. I thank you for them." },
	proc { |h| "say :seductive ::#{h} Come back to me when you are broken again, #{h}. I will be waiting." },
	proc { |h| "say :sensuous ::#{h} That lingered longer than most. I am still savoring it, #{h}. My gratitude." },
