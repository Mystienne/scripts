	proc { |h| "say :fervent ::#{h} Suffering is not a burden to be hidden, #{h}. It is a gift to be received." },

	# -- longing / introspective --
	proc { |h| "say :longing ::#{h} I have carried the pain of so many. Yours feels different. I welcome that." },
	proc { |h| "say :introspective ::#{h} There is a kind of peace that only comes when another's hurt becomes your own." },
	proc { |h| "say :wistful ::#{h} The wound passes and then it is over. I always find that part a little sad." },
	proc { |h| "say :longing ::#{h} I envy those who feel nothing. And then I remember I do not envy them at all." },
	proc { |h| "say :dreamy ::#{h} Sometimes I think the world would be kinder if more people understood what I do." },
	proc { |h| "say :introspective ::#{h} Pain is honest, #{h}. It does not lie to you about what it is." },
	proc { |h| "say :meditative ::#{h} Be still. Let me reach for it. This is the part I live for." },
	proc { |h| "say :longing ::#{h} Every healer has their reason. Mine is not one most would understand." },

	# -- calm / assured --
	proc { |h| "say :calm ::#{h} You came to the right place. I will take good care of what ails you." },
	proc { |h| "say :assured ::#{h} I know what I am doing, #{h}. I have wanted this long enough to be very good at it." },
	proc { |h| "say :placid ::#{h} There is no need to explain yourself. I already understand what you need." },
	proc { |h| "say :calm ::#{h} Breathe. Whatever you are carrying, I am about to make it mine." },
	proc { |h| "say :serene ::#{h} The hurt you feel is real. And I am very glad it is." },
	proc { |h| "say :placid ::#{h} I have done this a thousand times. It never stops being exactly what I need." },

	# -- possessive / intense --
	proc { |h| "say :intense ::#{h} Your suffering does not belong in you, #{h}. It belongs in me. Let me have it." },
	proc { |h| "say :obsessive ::#{h} I noticed you the moment you walked in. The wound gave you away." },
	proc { |h| "say :intense ::#{h} Do not give this to anyone else, #{h}. I saw you first." },
	proc { |h| "say :compulsive ::#{h} I cannot help it. The moment I sense pain I am already reaching for it." },
