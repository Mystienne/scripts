	proc { |h| "say :dark ::#{h} Most healers do this out of duty. I do it out of need. There is a difference." },
	proc { |h| "say :ominous ::#{h} Something in the world is wrong when the broken do not seek those who hunger for it." },

	# -- hungry / voracious --
	proc { |h| "say :voracious ::#{h} The gift of pain is the sweetest offering. Come, let me take yours." },
