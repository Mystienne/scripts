# encoding: utf-8
=begin

  debug-highlight-manager is a private tester tool for Highlight Manager.

  In simple terms, it can:
    - check Highlight Manager's config, saved character data, and import XML
    - write a diagnostic report to the highlights folder
    - summarize recent Lich temp crash/debug logs
    - back up known Highlight Manager and front-end files before testing
    - run command tests against Highlight Manager and restore saved files after
      those tests finish
    - clean older Highlight Manager debug/command text logs

  Privacy note: Warlock settings XML may include saved login/private data.
  Highlight Manager only reads highlight sections, but do not share Warlock XML
  or backup folders that include Warlock XML.

      Author: Mystienne
 Contributor: Peggyanne, Eternil
     Version: 1.0.0
       Build: 20260519.10
        Game: GS
        Tags: highlights, names, diagnostics, debug
    Required: Lich >= 5.11.0
       Email: Mystienne@mystienne.com
     Discord: Mystienne

=end

require 'fileutils'
require 'json'
require 'rexml/document'
require 'time'
require 'yaml'

[
  :HIGHLIGHT_MANAGER_DEBUG_VERSION,
  :HIGHLIGHT_MANAGER_DEBUG_BUILD,
  :VALID_MODES,
  :VALID_DUPLICATE_MODES,
  :PROFESSIONS,
  :RACES,
  :BUILT_IN_TAGS,
  :UNKNOWN_RACE_COLOR,
  :DEFAULT_RACE_COLORS,
].each do |const_name|
  begin
    remove_const(const_name) if const_defined?(const_name, false)
  rescue
    nil
  end
end

HIGHLIGHT_MANAGER_DEBUG_VERSION = '1.0.0'
HIGHLIGHT_MANAGER_DEBUG_BUILD = '20260519.10'
VALID_MODES = %w[profession race race_profession custom].freeze
VALID_DUPLICATE_MODES = %w[replace skip clear].freeze
PROFESSIONS = %w[
  Bard Cleric Empath Monk Paladin Ranger Rogue Sorcerer Warrior Wizard
].freeze
RACES = [
  'Human',
  'Giantman',
  'Half-Elf',
  'Sylvankind',
  'Dark Elf',
  'Elf',
  'Dwarf',
  'Halfling',
  'Forest Gnome',
  'Burghal Gnome',
  'Half-Krolvin',
  'Erithian',
  'Aelotoi',
].freeze
BUILT_IN_TAGS = %w[Friend Family Enemy Self].freeze
UNKNOWN_RACE_COLOR = '#7CFF00'
DEFAULT_RACE_COLORS = {
  'Human'         => ['#FFD166', ''],
  'Giantman'      => ['#FF9F7A', ''],
  'Half-Elf'      => ['#8EC9FF', ''],
  'Sylvankind'    => ['#66FF99', ''],
  'Dark Elf'      => ['#C792EA', ''],
  'Elf'           => ['#7FF7E5', ''],
  'Dwarf'         => ['#D08A3E', ''],
  'Halfling'      => ['#D6FF5C', ''],
  'Forest Gnome'  => ['#63D66D', ''],
  'Burghal Gnome' => ['#BFA0FF', ''],
  'Half-Krolvin'  => ['#FF7A85', ''],
  'Erithian'      => ['#FF85B8', ''],
  'Aelotoi'       => ['#B8FFFF', ''],
}.freeze

def nd_echo(message = '')
  if defined?(echo)
    echo message.to_s
  else
    puts message.to_s
  end
end

def user_home
  (Dir.home rescue nil) || ENV['USERPROFILE'] || ENV['HOME'] || Dir.pwd
end

def windows?
  !!(RUBY_PLATFORM =~ /mswin|mingw|cygwin/i)
end

def default_export_dir
  if windows?
    'C:/Gemstone IV Highlights'
  else
    File.join(user_home, 'GemStone IV Highlights')
  end
end

def data_dir
  if defined?(DATA_DIR) && DATA_DIR && Dir.exist?(DATA_DIR.to_s)
    DATA_DIR
  else
    script_dir = File.expand_path(__dir__) rescue Dir.pwd
    candidates = [
      ENV['LICH_DATA_DIR'],
      File.join(Dir.pwd, 'data'),
      File.expand_path(File.join(script_dir, '..', 'data')),
      File.join(user_home, 'Desktop', 'Lich5', 'data'),
      File.join(user_home, 'lich', 'data'),
    ].compact.map(&:to_s).reject(&:empty?)
    candidates.find { |path| Dir.exist?(path) } || candidates.first || Dir.pwd
  end
end

def lich_root_dir
  resolved = data_dir.to_s
  return File.dirname(resolved) if File.basename(resolved).downcase == 'data'

  script_dir = File.expand_path(__dir__) rescue nil
  return File.dirname(script_dir) if script_dir && File.basename(script_dir).downcase == 'scripts'

  Dir.pwd
rescue
  Dir.pwd
end

def lich_temp_dir
  File.join(lich_root_dir, 'temp')
end

def primary_config_path
  File.join(data_dir, 'highlight-manager.yml')
end

def legacy_script_basename
  'name' + 'highlights'
end

def legacy_config_paths
  ["#{legacy_script_basename}.yml", 'profhighlights.yml'].map { |filename| File.join(data_dir, filename) }
end

def config_path
  primary = primary_config_path
  return primary if File.exist?(primary)

  legacy = legacy_config_paths.find { |path| File.exist?(path) }
  legacy || primary
end

def safe_yaml_load_file(path)
  YAML.safe_load(File.read(path), permitted_classes: [], permitted_symbols: [], aliases: true)
end

def export_dir
  if File.exist?(config_path)
    data = safe_yaml_load_file(config_path)
    configured = data.is_a?(Hash) ? data['data_folder'].to_s.strip : ''
    return File.expand_path(configured) unless configured.empty?
  end
  default_export_dir
rescue
  default_export_dir
end

def primary_character_data_path
  File.join(export_dir, 'highlight-manager-characterdata.yml')
end

def legacy_character_data_paths
  [File.join(export_dir, "#{legacy_script_basename}-characterdata.yml")]
end

def character_data_path
  primary = primary_character_data_path
  return primary if File.exist?(primary)

  legacy = legacy_character_data_paths.find { |path| File.exist?(path) }
  legacy || primary
end

def primary_import_path
  File.join(export_dir, 'highlight-manager-importme.xml')
end

def legacy_import_paths
  [File.join(export_dir, "#{legacy_script_basename}-importme.xml")]
end

def legacy_import_xml_path?(path)
  filename = File.basename(path.to_s.tr('\\', '/'))
  legacy_import_paths.map { |candidate| File.basename(candidate) }.include?(filename)
end

def import_path
  primary = primary_import_path
  return primary if File.exist?(primary)

  legacy = legacy_import_paths.find { |path| File.exist?(path) }
  legacy || primary
end

def primary_wizard_path
  File.join(export_dir, 'highlight-manager_importme.cmd')
end

def legacy_wizard_paths
  [File.join(export_dir, "#{legacy_script_basename}_importme.cmd")]
end

def legacy_wizard_path
  primary = primary_wizard_path
  return primary if File.exist?(primary)

  legacy = legacy_wizard_paths.find { |path| File.exist?(path) }
  legacy || primary
end

def copy_legacy_file_to_primary_if_missing(primary, legacy_paths)
  return nil if File.exist?(primary)

  source = legacy_paths.find { |path| File.exist?(path) }
  return nil unless source

  FileUtils.mkdir_p(File.dirname(primary))
  FileUtils.cp(source, primary)
  "migrated #{File.basename(source)} -> #{File.basename(primary)}"
rescue => error
  "WARN: failed to migrate #{File.basename(primary)}: #{error.class}: #{error.message}"
end

def migrate_legacy_files_for_report
  [
    copy_legacy_file_to_primary_if_missing(primary_config_path, legacy_config_paths),
    copy_legacy_file_to_primary_if_missing(primary_character_data_path, legacy_character_data_paths),
    copy_legacy_file_to_primary_if_missing(primary_import_path, legacy_import_paths),
    copy_legacy_file_to_primary_if_missing(primary_wizard_path, legacy_wizard_paths),
  ].compact
end

def write_yaml_file(path, data)
  FileUtils.mkdir_p(File.dirname(path))
  temp_path = "#{path}.tmp"
  File.write(temp_path, data.to_yaml)
  YAML.safe_load(File.read(temp_path), permitted_classes: [], permitted_symbols: [], aliases: true)
  FileUtils.mv(temp_path, path)
ensure
  File.delete(temp_path) if temp_path && File.exist?(temp_path)
end

def migrate_saved_legacy_paths_for_report(report)
  path = primary_config_path
  return unless File.exist?(path)

  data = safe_yaml_load_file(path)
  return unless data.is_a?(Hash)

  changed = false
  preferred_import = primary_import_path
  copy_settings = data['copy_settings'].is_a?(Hash) ? data['copy_settings'] : {}
  if legacy_import_xml_path?(copy_settings['source_path'])
    copy_settings['source_path'] = preferred_import
    copy_settings['confirmed'] = false
    data['copy_settings'] = copy_settings
    changed = true
  end

  recent_paths = data['recent_paths'].is_a?(Hash) ? data['recent_paths'] : {}
  if legacy_import_xml_path?(recent_paths['last_import_xml'])
    recent_paths['last_import_xml'] = preferred_import
    data['recent_paths'] = recent_paths
    changed = true
  end

  return unless changed

  write_yaml_file(path, data)
  report << "NOTE: updated saved import/copy paths to #{File.basename(preferred_import)}"
rescue => error
  report << "WARN: failed to update saved import/copy paths: #{error.class}: #{error.message}"
end

def main_script_candidates
  script_dir = File.expand_path(__dir__) rescue nil
  resolved_data = data_dir rescue nil
  [
    script_dir && File.join(script_dir, 'highlight-manager.lic'),
    resolved_data && File.expand_path(File.join(resolved_data, '..', 'scripts', 'highlight-manager.lic')),
    File.join(Dir.pwd, 'scripts', 'highlight-manager.lic'),
    File.join(Dir.pwd, 'highlight-manager.lic'),
    File.join(user_home, 'Desktop', 'Lich5', 'scripts', 'highlight-manager.lic'),
    File.join(user_home, 'lich', 'scripts', 'highlight-manager.lic'),
  ].compact.map { |path| File.expand_path(path) }.uniq
rescue
  [File.join(Dir.pwd, 'highlight-manager.lic')]
end

def main_command_name
  'highlight-manager'
end

def main_command_names
  ['highlight-manager']
end

def main_script_path
  main_script_candidates.find { |path| File.file?(path) }
end

def main_script_version_label
  path = main_script_path
  return 'not found' unless File.exist?(path)

  text = File.read(path)
  version = text[/HIGHLIGHT_MANAGER_VERSION\s*=\s*['"]([^'"]+)['"]/, 1]
  build = text[/HIGHLIGHT_MANAGER_BUILD\s*=\s*['"]([^'"]+)['"]/, 1]
  return 'unknown' if version.to_s.empty?

  build.to_s.empty? ? version : "#{version} build #{build}"
rescue => error
  "unreadable (#{error.class}: #{error.message})"
end

def report_path
  FileUtils.mkdir_p(export_dir)
  stamp = Time.now.strftime('%Y%m%d-%H%M%S')
  File.join(export_dir, "debug-highlight-manager-#{stamp}.txt")
end

def command_transcript_token
  stamp = Time.now.strftime('%Y%m%d-%H%M%S')
  stamp
end

def command_transcript_path(token)
  FileUtils.mkdir_p(export_dir)
  File.join(export_dir, "highlight-manager-command-#{token}.txt")
end

def backup_root_path
  FileUtils.mkdir_p(export_dir)
  stamp = Time.now.strftime('%Y%m%d-%H%M%S')
  File.join(export_dir, "highlight-manager-backup-#{stamp}")
end

def log_file_pattern
  /\A(?:debug-highlight-manager|highlight-manager-command)-\d{8}-\d{6}\.txt\z/
end

def matching_log_files
  return [] unless Dir.exist?(export_dir)

  Dir.children(export_dir).select { |name| name =~ log_file_pattern }.map { |name| File.join(export_dir, name) }.select { |path| File.file?(path) }
end

def safe_inside_export_dir?(path)
  root = File.expand_path(export_dir)
  resolved = File.expand_path(path)
  resolved.start_with?(root + File::SEPARATOR)
end

def add_cleanlogs_report(report, keep_current_path = nil)
  report << ''
  report << 'Log Cleanup'
  report << '-----------'
  unless Dir.exist?(export_dir)
    report << "NOTE: highlights folder does not exist: #{export_dir}"
    return
  end

  files = matching_log_files.sort_by { |path| File.mtime(path) rescue Time.at(0) }.reverse
  keep = keep_current_path || files.first
  keep = File.expand_path(keep) if keep
  deleted = 0

  files.each do |path|
    expanded = File.expand_path(path)
    next if keep && expanded == keep

    unless safe_inside_export_dir?(expanded)
      report << "WARN: skipped suspicious path outside highlights folder: #{expanded}"
      next
    end

    File.delete(expanded)
    deleted += 1
  rescue => error
    report << "WARN: failed to delete #{path}: #{error.class}: #{error.message}"
  end

  report << "Deleted old Highlight Manager debug/command logs: #{deleted}"
  report << "Kept: #{keep || '(none found)'}"
end

def file_summary(path)
  return 'missing' unless File.exist?(path)

  "#{File.size(path)} bytes, modified #{File.mtime(path).strftime('%Y-%m-%d %H:%M:%S')}"
end

def safe_yaml(path, label, report)
  unless File.exist?(path)
    if label == 'character data'
      report << "NOTE: #{label} file is missing; this is normal before the first 3-mode scan: #{path}"
    else
      report << "WARN: #{label} file is missing: #{path}"
    end
    return {}
  end

  data = safe_yaml_load_file(path)
  unless data.is_a?(Hash)
    report << "WARN: #{label} YAML root is #{data.class}; expected Hash."
    return {}
  end

  report << "OK: #{label} YAML parsed."
  data
rescue => error
  report << "ERROR: #{label} YAML failed to parse: #{error.class}: #{error.message}"
  {}
end

def safe_path_label(path)
  path.to_s.gsub(/[^A-Za-z0-9_.-]+/, '_').gsub(/\A_+|_+\z/, '')[0, 80]
end

def copy_file_with_report(source, destination, report)
  FileUtils.mkdir_p(File.dirname(destination))
  if File.extname(source).downcase == '.json'
    return copy_redacted_json_with_report(source, destination, report)
  end

  FileUtils.cp(source, destination)
  report << "BACKUP: #{source} -> #{destination}"
  true
rescue => error
  report << "WARN: failed to back up #{source}: #{error.class}: #{error.message}"
  false
end

def sensitive_json_key?(key)
  key.to_s =~ /\A(?:password|pass|pwd|username|user|login|account|token|secret|api[_-]?key|session|cookie|auth)\z/i
end

def redact_json_secrets(value)
  case value
  when Hash
    value.each_with_object({}) do |(key, child), copy|
      copy[key] = sensitive_json_key?(key) ? '[REDACTED]' : redact_json_secrets(child)
    end
  when Array
    value.map { |child| redact_json_secrets(child) }
  else
    value
  end
end

def copy_redacted_json_with_report(source, destination, report)
  data = JSON.parse(File.read(source))
  File.write(destination, JSON.pretty_generate(redact_json_secrets(data)) + "\n")
  report << "BACKUP: #{source} -> #{destination} (JSON secrets redacted)"
  true
rescue => error
  report << "WARN: #{source} looked like JSON but could not be redacted: #{error.class}: #{error.message}"
  false
end

def backup_single_file(source, backup_root, subdir, report)
  return unless source && File.file?(source)

  destination = File.join(backup_root, subdir, File.basename(source))
  copy_file_with_report(source, destination, report)
end

def backup_matching_files(source_dir, backup_root, label, report, patterns = ['*.xml', '*.json', '*.plist', '*.cmd', '*.wiz'])
  return 0 unless source_dir && Dir.exist?(source_dir)

  target_dir = File.join(backup_root, 'frontend-files', safe_path_label(label))
  copied = 0
  skipped = 0
  total_bytes = 0
  max_files = 500
  max_bytes = 100 * 1024 * 1024
  files = patterns.flat_map { |pattern| Dir.glob(File.join(source_dir, pattern)) }.uniq.select { |path| File.file?(path) }
  files.sort.each do |source|
    size = File.size(source) rescue 0
    if copied >= max_files || total_bytes + size > max_bytes
      skipped += 1
      next
    end

    destination = File.join(target_dir, File.basename(source))
    copied += 1 if copy_file_with_report(source, destination, report)
    total_bytes += size
  end

  report << "BACKUP: #{source_dir} copied #{copied} file(s)#{skipped.positive? ? ", skipped #{skipped} due to backup limits" : ''}."
  copied
end

def frontend_backup_candidates(config)
  candidates = []
  copy_settings = config.is_a?(Hash) && config['copy_settings'].is_a?(Hash) ? config['copy_settings'] : {}
  candidates << ['saved-copy-target', copy_settings['target_dir'].to_s] unless copy_settings['target_dir'].to_s.strip.empty?

  if windows?
    appdata = ENV['APPDATA'].to_s
    candidates << ['wrayth-gs4-appdata', File.join(appdata, 'Wrayth', 'GS4')] unless appdata.empty?
    candidates << ['stormfront-gs4-appdata', File.join(appdata, 'StormFront', 'GS4')] unless appdata.empty?
    candidates << ['warlock-appdata', File.join(appdata, 'Warlock')] unless appdata.empty?
  else
    library = File.join(user_home, 'Library', 'Application Support')
    candidates << ['wrayth-gs4-library', File.join(library, 'Wrayth', 'GS4')]
    candidates << ['stormfront-gs4-library', File.join(library, 'StormFront', 'GS4')]
    candidates << ['warlock-library', File.join(library, 'Warlock')]
    candidates << ['lich-data', data_dir]
  end

  candidates.uniq { |_label, path| path }
end

def add_backup_report(report, config)
  backup_root = backup_root_path
  FileUtils.mkdir_p(backup_root)

  report << ''
  report << 'Backup'
  report << '------'
  report << "backup folder: #{backup_root}"
  backup_single_file(config_path, backup_root, 'highlight-manager-files', report)
  backup_single_file(character_data_path, backup_root, 'highlight-manager-files', report)
  backup_single_file(import_path, backup_root, 'highlight-manager-files', report)
  backup_single_file(legacy_wizard_path, backup_root, 'highlight-manager-files', report)

  found_frontend_dir = false
  frontend_backup_candidates(config).each do |label, path|
    next if path.to_s.strip.empty?

    if Dir.exist?(path)
      found_frontend_dir = true
      backup_matching_files(path, backup_root, label, report)
    else
      report << "BACKUP: frontend candidate missing: #{label} #{path}"
    end
  end

  report << 'WARN: no known front-end settings folders were found to back up.' unless found_frontend_dir
  report << 'Backup is read-only: no live settings files were changed.'
rescue => error
  report << "ERROR: backup failed: #{error.class}: #{error.message}"
end

def valid_hex?(value)
  value.to_s.strip =~ /\A#[0-9A-Fa-f]{6}\z/
end

def palette_color_token?(value)
  value.to_s.strip =~ /\A@\d+\z/
end

def valid_color_value?(value)
  valid_hex?(value) || palette_color_token?(value)
end

def transparent?(value)
  text = value.to_s.strip
  text.empty? || text =~ /\A(?:none|transparent|clear)\z/i
end

def validate_color_pair(report, label, pair, allow_transparent_back = true)
  unless pair.is_a?(Array) && pair.length == 2
    report << "WARN: #{label} color should be a two-item list."
    return
  end

  fore, back = pair
  report << "WARN: #{label} foreground is not #RRGGBB: #{fore.inspect}" unless valid_hex?(fore)
  unless valid_hex?(back) || (allow_transparent_back && transparent?(back))
    report << "WARN: #{label} background is not #RRGGBB or transparent: #{back.inspect}"
  end
end

def normalize_name(name)
  name.to_s.strip
end

def character_records(data)
  names = data['names']
  return {} unless names.is_a?(Hash)

  names
end

def import_document(path, report)
  return nil unless File.exist?(path)

  REXML::Document.new(File.read(path))
rescue => error
  report << "ERROR: import XML failed to parse: #{error.class}: #{error.message}"
  nil
end

def xml_text_attribute(element)
  element.attributes['text'] ||
    element.attributes['string'] ||
    element.attributes['name'] ||
    element.attributes['content']
end

def collect_import_entries(doc)
  entries = []
  return entries unless doc

  REXML::XPath.each(doc, '//*') do |element|
    text = xml_text_attribute(element)
    next if text.to_s.strip.empty?

    fore = element.attributes['foreColor'] ||
           element.attributes['foreground'] ||
           element.attributes['fgColor'] ||
           element.attributes['color']
    back = element.attributes['backColor'] ||
           element.attributes['background'] ||
           element.attributes['bgColor'] ||
           element.attributes['bgcolor']
    entries << {
      name: element.name,
      section: (element.parent&.name rescue ''),
      text: text.to_s.strip,
      fore: fore.to_s.strip,
      back: back.to_s.strip,
    }
  end
  entries
end

def count_by(records)
  counts = Hash.new(0)
  records.each { |value| counts[value] += 1 unless value.to_s.strip.empty? }
  counts.sort.to_h
end

def add_config_report(report, config)
  report << ''
  report << 'Config'
  report << '------'
  mode = config['mode'].to_s
  legacy_config = mode.empty?
  report << "mode: #{mode.empty? ? '(missing)' : mode}"
  report << "frontend: #{config['frontend'].to_s.empty? ? '(missing)' : config['frontend']}"
  data_folder = config['data_folder'].to_s.strip
  report << "data_folder: #{data_folder.empty? ? "#{export_dir} (runtime default)" : data_folder}"
  unknown_race_color = config['unknown_race_color'].to_s.strip
  unknown_race_color = UNKNOWN_RACE_COLOR if unknown_race_color.empty?
  report << "unknown_race_color: #{unknown_race_color}#{config['unknown_race_color'].to_s.strip.empty? ? ' (runtime default)' : ''}"
  report << "copy_settings: #{config['copy_settings'].is_a?(Hash) ? config['copy_settings'].inspect : '(missing or invalid)'}"
  recent_paths = config['recent_paths'].is_a?(Hash) ? config['recent_paths'] : {}
  report << "recent import XML: #{recent_paths['last_import_xml'].to_s.strip.empty? ? '(not set)' : recent_paths['last_import_xml']}"
  if legacy_config
    report << 'NOTE: mode is missing because this looks like an older profession-only config. The main script should migrate it on first run.'
  elsif !VALID_MODES.include?(mode)
    report << "WARN: invalid mode #{mode.inspect}; expected #{VALID_MODES.join(', ')}"
  end
  report << 'WARN: unknown_race_color is not #RRGGBB.' unless valid_hex?(unknown_race_color)

  profession_colors = config['profession_colors'].is_a?(Hash) ? config['profession_colors'] : {}
  race_colors = config['race_colors'].is_a?(Hash) ? config['race_colors'] : {}
  tag_colors = config['tag_colors'].is_a?(Hash) ? config['tag_colors'] : {}

  missing_professions = PROFESSIONS - profession_colors.keys
  missing_races = RACES - race_colors.keys
  missing_tags = BUILT_IN_TAGS - tag_colors.keys
  report << "profession_colors: #{profession_colors.length} entries"
  report << "race_colors: #{race_colors.length} entries"
  report << "tag_colors: #{tag_colors.length} entries"
  report << "WARN: missing profession colors: #{missing_professions.join(', ')}" unless missing_professions.empty?
  if legacy_config && missing_races.length == RACES.length
    report << 'NOTE: race colors are missing because this looks like an older profession-only config.'
  else
    report << "WARN: missing race colors: #{missing_races.join(', ')}" unless missing_races.empty?
  end
  if legacy_config && missing_tags == ['Self']
    report << 'NOTE: Self tag color is missing because this looks like an older config; it should be added as white on transparent.'
  else
    report << "WARN: missing built-in tag colors: #{missing_tags.join(', ')}" unless missing_tags.empty?
  end

  profession_colors.each { |name, pair| validate_color_pair(report, "profession #{name}", pair) }
  tag_colors.each { |name, pair| validate_color_pair(report, "tag #{name}", pair) }
  race_colors.each do |name, value|
    if value.is_a?(Array)
      validate_color_pair(report, "race #{name}", value)
    else
      report << "NOTE: race #{name} still uses old foreground-only color format: #{value.inspect}" unless valid_hex?(value)
    end
  end

  copy = config['copy_settings'].is_a?(Hash) ? config['copy_settings'] : {}
  duplicate_mode = copy['duplicates'].to_s
  if !duplicate_mode.empty? && !VALID_DUPLICATE_MODES.include?(duplicate_mode)
    report << "WARN: copy duplicate mode #{duplicate_mode.inspect} is invalid."
  end
  source = copy['source_path'].to_s
  target = copy['target_dir'].to_s
  report << "copy source exists: #{source.empty? ? '(not set)' : File.exist?(source)}"
  report << "copy target exists: #{target.empty? ? '(not set)' : Dir.exist?(target)}"
end

def add_character_data_report(report, data)
  records = character_records(data)
  values = records.values.select { |entry| entry.is_a?(Hash) }
  bad_records = records.length - values.length
  names = values.map { |entry| normalize_name(entry['name']) }
  duplicate_display_names = names.group_by(&:downcase).select { |_key, list| list.length > 1 }
  with_profession = values.count { |entry| !entry['profession'].to_s.strip.empty? }
  with_race = values.count { |entry| !entry['race'].to_s.strip.empty? }
  with_both = values.count { |entry| !entry['profession'].to_s.strip.empty? && !entry['race'].to_s.strip.empty? }
  with_custom = values.count { |entry| !entry['custom_tag'].to_s.strip.empty? }

  report << ''
  report << 'Character Data'
  report << '--------------'
  report << "records: #{records.length}"
  report << "invalid records: #{bad_records}"
  report << "with profession: #{with_profession}"
  report << "with race: #{with_race}"
  report << "with both: #{with_both}"
  report << "with custom tag: #{with_custom}"
  report << "profession only: #{values.count { |entry| !entry['profession'].to_s.strip.empty? && entry['race'].to_s.strip.empty? }}"
  report << "race only: #{values.count { |entry| entry['profession'].to_s.strip.empty? && !entry['race'].to_s.strip.empty? }}"
  report << "no race/profession data: #{values.count { |entry| entry['profession'].to_s.strip.empty? && entry['race'].to_s.strip.empty? }}"
  report << "profession counts: #{count_by(values.map { |entry| entry['profession'].to_s.strip }).inspect}"
  report << "race counts: #{count_by(values.map { |entry| entry['race'].to_s.strip }).inspect}"
  report << "custom tag counts: #{count_by(values.map { |entry| entry['custom_tag'].to_s.strip }).inspect}"
  report << "WARN: duplicate display names: #{duplicate_display_names.keys.join(', ')}" unless duplicate_display_names.empty?

  invalid_names = values.map { |entry| normalize_name(entry['name']) }.select { |name| name.empty? || name !~ /\A[A-Za-z][A-Za-z'-]{1,29}\z/ }
  report << "WARN: invalid-looking character names: #{invalid_names.first(25).join(', ')}" unless invalid_names.empty?
end

def add_import_report(report, config, data)
  path = import_path
  report << ''
  report << 'Import File'
  report << '-----------'
  report << "path: #{path}"
  report << "status: #{file_summary(path)}"
  doc = import_document(path, report)
  return unless doc

  report << 'OK: import XML parsed.'
  entries = collect_import_entries(doc)
  name_entries = entries.select { |entry| entry[:section].to_s.downcase == 'names' }
  string_entries = entries.select { |entry| entry[:section].to_s.downcase == 'strings' }
  custom_entries = string_entries.select { |entry| entry[:text] =~ /\A-=\{ .+ \}=-\z/ }
  custom_text_entries = string_entries - custom_entries
  duplicate_import_texts = entries.map { |entry| entry[:text] }.group_by(&:downcase).select { |_key, list| list.length > 1 }

  report << "total highlight-like entries: #{entries.length}"
  report << "legend/custom label entries: #{custom_entries.length}"
  report << "custom text entries: #{custom_text_entries.length}"
  report << "name highlight entries: #{name_entries.length}"
  report << "transparent backgrounds: #{entries.count { |entry| transparent?(entry[:back]) }}"
  report << "WARN: duplicate import strings: #{duplicate_import_texts.keys.first(40).join(', ')}" unless duplicate_import_texts.empty?

  palette_fore = entries.select { |entry| palette_color_token?(entry[:fore]) }
  palette_back = entries.select { |entry| palette_color_token?(entry[:back]) }
  bad_fore = entries.reject { |entry| valid_color_value?(entry[:fore]) }
  bad_back = entries.reject { |entry| valid_color_value?(entry[:back]) || transparent?(entry[:back]) }
  report << "NOTE: entries using front-end palette foreground tokens: #{palette_fore.first(20).map { |entry| entry[:text] }.join(', ')}" unless palette_fore.empty?
  report << "NOTE: entries using front-end palette background tokens: #{palette_back.first(20).map { |entry| entry[:text] }.join(', ')}" unless palette_back.empty?
  report << "WARN: entries with invalid foreground colors: #{bad_fore.first(20).map { |entry| entry[:text] }.join(', ')}" unless bad_fore.empty?
  report << "WARN: entries with invalid backgrounds: #{bad_back.first(20).map { |entry| entry[:text] }.join(', ')}" unless bad_back.empty?

  records = character_records(data)
  record_names = records.values.select { |entry| entry.is_a?(Hash) }.map { |entry| normalize_name(entry['name']).downcase }
  imported_names = name_entries.map { |entry| entry[:text].downcase }
  missing_from_data = imported_names.reject { |name| record_names.include?(name) }
  not_exported = record_names.reject { |name| imported_names.include?(name) }
  report << "imported names not in character data: #{missing_from_data.length}"
  report << "character data names not in import: #{not_exported.length}"
  report << "sample not exported: #{not_exported.first(25).join(', ')}" unless not_exported.empty?

  mode = config['mode'].to_s
  if mode == 'race_profession'
    race_only = records.values.count { |entry| entry.is_a?(Hash) && entry['profession'].to_s.strip.empty? && !entry['race'].to_s.strip.empty? }
    profession_only = records.values.count { |entry| entry.is_a?(Hash) && !entry['profession'].to_s.strip.empty? && entry['race'].to_s.strip.empty? }
    report << "race+profession fallback expected race-only transparent backgrounds: #{race_only}"
    report << "race+profession fallback expected profession-only unknown foregrounds: #{profession_only}"
  end
end

def add_environment_report(report)
  report << 'Highlight Manager Diagnostic Report'
  report << "Generated: #{Time.now.strftime('%Y-%m-%d %H:%M:%S')}"
  report << "Highlight Manager debug: #{HIGHLIGHT_MANAGER_DEBUG_VERSION} build #{HIGHLIGHT_MANAGER_DEBUG_BUILD}"
  report << "Highlight Manager main: #{main_script_version_label}"
  report << "Ruby: #{RUBY_VERSION} #{RUBY_PLATFORM}"
  report << "Lich frontend: #{defined?($frontend) ? $frontend.inspect : '(unknown)'}"
  report << "Working directory: #{Dir.pwd}"
  report << "Lich DATA_DIR: #{defined?(DATA_DIR) ? DATA_DIR : '(not defined)'}"
  report << "Resolved data dir: #{data_dir}"
  report << "Highlight Manager folder: #{export_dir}"
  report << ''
  report << 'Files'
  report << '-----'
  report << "config: #{config_path}"
  report << "config status: #{file_summary(config_path)}"
  report << "character data: #{character_data_path}"
  report << "character data status: #{file_summary(character_data_path)}"
  report << "import XML: #{import_path}"
  report << "import XML status: #{file_summary(import_path)}"
  report << "wizard CMD: #{legacy_wizard_path}"
  report << "wizard CMD status: #{file_summary(legacy_wizard_path)}"
end

def recent_lich_debug_logs(limit = 5)
  dir = lich_temp_dir
  return [] unless Dir.exist?(dir)

  Dir.children(dir)
     .select { |name| name =~ /\Adebug-\d{4}-\d{2}-\d{2}-\d{2}-\d{2}-\d{2}-\d{3}\.log\z/ }
     .map { |name| File.join(dir, name) }
     .select { |path| File.file?(path) }
     .sort_by { |path| File.mtime(path) rescue Time.at(0) }
     .last(limit)
     .reverse
rescue
  []
end

def lich_debug_relevant_lines(limit_files = 5, limit_lines = 25)
  pattern = /highlight-manager|Gtk|GLib|ThreadError|Connection error|Fatal connection|server_thread|exception|error in Gtk\.queue|already initialized constant/i
  matches = []
  recent_lich_debug_logs(limit_files).reverse_each do |path|
    line_number = 0
    File.foreach(path) do |line|
      line_number += 1
      next unless line =~ pattern

      matches << "#{File.basename(path)}:#{line_number}: #{line.strip}"
    end
  rescue => error
    matches << "#{File.basename(path)}: unreadable (#{error.class}: #{error.message})"
  end
  matches.last(limit_lines)
end

def add_lich_temp_report(report)
  report << ''
  report << 'Lich Temp Debug Logs'
  report << '--------------------'
  report << "path: #{lich_temp_dir}"
  unless Dir.exist?(lich_temp_dir)
    report << 'status: missing'
    return
  end

  logs = recent_lich_debug_logs(5)
  report << "recent debug logs: #{logs.length}"
  logs.each do |path|
    report << "  #{File.basename(path)}: #{file_summary(path)}"
  end
  report << 'note: Lich temp logs may include local paths or game text. Review before sharing.'

  relevant = lich_debug_relevant_lines(5, 25)
  if relevant.empty?
    report << 'recent relevant lines: none found in latest logs'
  else
    report << 'recent relevant lines:'
    relevant.each { |line| report << "  #{line}" }
  end
end

def script_args
  if defined?(Script) && Script.respond_to?(:current) && Script.current.respond_to?(:vars)
    Script.current.vars.map(&:to_s)
  else
    ARGV.map(&:to_s)
  end
end

def command_capture_mode(args)
  lowered = args.map(&:downcase)
  return :fulltest if lowered.include?('fulltest') || lowered.include?('alltest')
  return :test if lowered.include?('test') || lowered.include?('selftest')
  return :scan if lowered.include?('scan') || lowered.include?('live')
  return :safe if lowered.include?('run') || lowered.include?('commands')

  nil
end

def backup_requested?(args)
  args.map(&:downcase).include?('backup')
end

def cleanlogs_requested?(args)
  lowered = args.map(&:downcase)
  lowered.include?('cleanlogs') || lowered.include?('cleanup') || lowered.include?('clean')
end

def help_requested?(args)
  lowered = args.map(&:downcase)
  lowered.empty? ? false : (lowered.include?('help') || lowered.include?('--help') || lowered.include?('-h') || lowered.include?('?'))
end

def show_usage
  nd_echo ''
  nd_echo 'Highlight Manager Debug Commands'
  nd_echo ''
  nd_echo '  ;debug-highlight-manager'
  nd_echo '      Write a safe diagnostic report. Does not scan WHO or edit live character XML files.'
  nd_echo ''
  nd_echo '  ;debug-highlight-manager backup'
  nd_echo '      Safe diagnostic report plus a timestamped backup of known Highlight Manager/front-end files.'
  nd_echo '      Highlight Manager only reads highlights, but do not share Warlock XML or backups that include it.'
  nd_echo ''
  nd_echo '  ;debug-highlight-manager scan'
  nd_echo '      Runs ;highlight-manager debug through the companion, scans WHO, rewrites the import file, and records a transcript.'
  nd_echo ''
  nd_echo '  ;debug-highlight-manager run'
  nd_echo '      Runs safe command checks: mode, lookup room, legend, and copy status.'
  nd_echo ''
  nd_echo '  ;debug-highlight-manager test'
  nd_echo '      Runs command self-tests with temporary data and restores Highlight Manager files afterward.'
  nd_echo ''
  nd_echo '  ;debug-highlight-manager fulltest'
  nd_echo '      Runs the broadest command test set, including temporary copy-mode tests, then restores files.'
  nd_echo ''
  nd_echo '  ;debug-highlight-manager cleanlogs'
  nd_echo '      Deletes older Highlight Manager debug/command text logs from the highlights folder.'
  nd_echo ''
  nd_echo '  Commands can be combined when useful, for example:'
  nd_echo '      ;debug-highlight-manager backup scan'
  nd_echo '      ;debug-highlight-manager fulltest cleanlogs'
  nd_echo ''
end

def lich_script_runner_available?
  defined?(start_script) && defined?(running?) && defined?(wait_while)
end

def highlight_manager_running_exact?
  if defined?(Script) && Script.respond_to?(:running)
    current_script = defined?(Script) && Script.respond_to?(:current) ? Script.current : nil
    names = main_command_names
    Script.running.any? do |running_script|
      next false if current_script && running_script.equal?(current_script)
      next false unless running_script.respond_to?(:name)

      names.include?(running_script.name.to_s.downcase)
    end
  else
    main_command_names.any? { |name| running?(name) }
  end
end

def wait_for_highlight_manager_to_finish(timeout_seconds)
  started = Time.now
  wait_while do
    highlight_manager_running_exact? && (Time.now - started) < timeout_seconds
  end
  !highlight_manager_running_exact?
end

def run_highlight_manager_command(report, transcript, command_args, timeout_seconds = 180)
  command_name = main_command_name
  unless lich_script_runner_available?
    report << "WARN: cannot run ;#{command_name} #{command_args.join(' ')} outside Lich."
    return
  end

  full_args = command_args + ['report', transcript]
  report << "RUN: ;#{command_name} #{command_args.join(' ')}"
  nd_echo "Running ;#{command_name} #{command_args.join(' ')}"
  start_script(command_name, full_args)
  if wait_for_highlight_manager_to_finish(timeout_seconds)
    report << "OK: ;#{command_name} #{command_args.join(' ')} finished."
  else
    report << "WARN: ;#{command_name} #{command_args.join(' ')} did not finish within #{timeout_seconds} seconds."
  end
rescue => error
  report << "ERROR: failed to run ;#{command_name || 'highlight-manager'} #{command_args.join(' ')}: #{error.class}: #{error.message}"
end

def snapshot_paths
  [
    primary_config_path,
    *legacy_config_paths,
    primary_character_data_path,
    *legacy_character_data_paths,
    primary_import_path,
    *legacy_import_paths,
    primary_wizard_path,
    *legacy_wizard_paths,
  ].uniq
end

def snapshot_files
  snapshot_paths.each_with_object({}) do |path, snapshot|
    snapshot[path] = File.exist?(path) ? File.binread(path) : nil
  end
end

def restore_files(snapshot, report)
  snapshot.each do |path, content|
    if content.nil?
      File.delete(path) if File.exist?(path)
    else
      FileUtils.mkdir_p(File.dirname(path))
      File.binwrite(path, content)
    end
  end
  report << 'OK: restored config, character data, and generated export files after command test.'
rescue => error
  report << "ERROR: failed to restore files after command test: #{error.class}: #{error.message}"
end

def test_records
  character_records(safe_yaml_load_file(character_data_path))
rescue
  {}
end

def test_config
  safe_yaml_load_file(config_path)
rescue
  {}
end

def record_has?(name, field, expected)
  record = test_records[name.downcase]
  record.is_a?(Hash) && record[field].to_s == expected
end

def record_field(name, field)
  record = test_records[name.downcase]
  record.is_a?(Hash) ? record[field].to_s : ''
end

def config_tag_color(tag)
  config = test_config
  colors = config['tag_colors'].is_a?(Hash) ? config['tag_colors'] : {}
  colors[tag]
end

def next_imported_tag_without_color
  config = test_config
  colors = config['tag_colors'].is_a?(Hash) ? config['tag_colors'] : {}
  index = 1
  loop do
    candidate = "Imported #{index}"
    return candidate unless colors.keys.any? { |tag| tag.to_s.downcase == candidate.downcase }

    index += 1
  end
end

def write_orphan_imported_tag_record(name, tag)
  data = File.exist?(character_data_path) ? safe_yaml_load_file(character_data_path) : {}
  data = {} unless data.is_a?(Hash)
  data['names'] = {} unless data['names'].is_a?(Hash)
  now = Time.now.utc.iso8601
  data['names'][name.downcase] = {
    'name' => name,
    'profession' => '',
    'race' => '',
    'manual_profession' => '',
    'manual_race' => '',
    'custom_tag' => tag,
    'first_seen' => now,
    'last_seen' => '',
    'profession_updated_at' => '',
    'race_updated_at' => '',
    'manual_profession_updated_at' => '',
    'manual_race_updated_at' => '',
    'custom_updated_at' => now,
  }
  FileUtils.mkdir_p(File.dirname(character_data_path))
  File.write(character_data_path, YAML.dump(data))
end

def import_contains_text?(text)
  return false unless File.exist?(import_path)

  content = File.read(import_path)
  content.include?("text='#{text}'") || content.include?("text=\"#{text}\"")
end

def command_transcript_text(token)
  path = command_transcript_path(token)
  return '' unless File.exist?(path)

  File.read(path)
rescue
  ''
end

def command_transcript_includes?(token, text)
  command_transcript_text(token).include?(text.to_s)
end

def write_copy_test_source(path)
  FileUtils.mkdir_p(File.dirname(path))
  File.write(path, <<~XML)
    <settings>
      <strings local=''>
        <h text='-={ CopyTest }=-' color='#ABCDEF' bgcolor='#123456' case='y'/>
      </strings>
      <names local=''>
        <h text='Copyalpha' color='#111111' bgcolor='#222222' case='y'/>
        <h text='Copybeta' color='#333333' bgcolor='#444444' case='y'/>
      </names>
    </settings>
  XML
end

def write_copy_test_target(path)
  FileUtils.mkdir_p(File.dirname(path))
  File.write(path, <<~XML)
    <settings>
      <strings local=''>
        <h text='-={ CopyTest }=-' color='#000000' bgcolor='#000000' case='y'/>
        <h text='KeepString' color='#010101' bgcolor='#020202' case='y'/>
      </strings>
      <names local=''>
        <h text='Copyalpha' color='#000000' bgcolor='#000000' case='y'/>
        <h text='Keepname' color='#010101' bgcolor='#020202' case='y'/>
      </names>
    </settings>
  XML
end

def write_importxml_test_source(path)
  FileUtils.mkdir_p(File.dirname(path))
  File.write(path, <<~XML)
    <settings>
      <strings local=''>
        <h text='Unrelated custom string' color='#010203' bgcolor='#040506' case='y'/>
      </strings>
      <names local=''>
        <h text='Nhdebugimportone' color='#AA5500' bgcolor='#001122' case='y'/>
        <h text='Nhdebugimporttwo' color='#AA5500' bgcolor='#001122' case='y'/>
        <h text='Nhdebugimportcombo' color='#FFD166' bgcolor='#5A005A' case='y'/>
        <h text='not a valid phrase' color='#FFFFFF' bgcolor='#000000' case='y'/>
      </names>
    </settings>
  XML
end

def copy_test_target_entry(path, section, text)
  doc = REXML::Document.new(File.read(path))
  node = doc.root.elements[section]&.get_elements('h')&.find { |item| item.attributes['text'].to_s.downcase == text.downcase }
  return nil unless node

  { fore: node.attributes['color'].to_s, back: node.attributes['bgcolor'].to_s }
rescue
  nil
end

def copy_test_entry_exists?(path, section, text)
  !!copy_test_target_entry(path, section, text)
end

def import_entry_for(text)
  doc = import_document(import_path, [])
  collect_import_entries(doc).find { |entry| entry[:text].to_s.downcase == text.to_s.downcase }
end

def configured_profession_pair(profession)
  config = test_config
  colors = config['profession_colors'].is_a?(Hash) ? config['profession_colors'] : {}
  pair = colors[profession]
  pair.is_a?(Array) ? pair : nil
end

def configured_race_pair(race)
  config = test_config
  colors = config['race_colors'].is_a?(Hash) ? config['race_colors'] : {}
  default_pair = DEFAULT_RACE_COLORS[race]
  pair = colors[race]
  pair = [pair, default_pair[1]] unless pair.is_a?(Array)
  return default_pair unless pair.is_a?(Array) && pair.length == 2

  fore = pair[0].to_s.strip.upcase
  fore = '' if race == 'Human' && fore == '#FFFFFF'
  fore = default_pair[0] unless valid_hex?(fore)
  back = pair[1].to_s.strip.upcase
  back = default_pair[1] unless back.empty? || valid_hex?(back)
  [fore, back]
end

def entry_colors_match?(name, fore, back)
  entry = import_entry_for(name)
  entry && entry[:fore].to_s.upcase == fore.to_s.upcase && entry[:back].to_s.upcase == back.to_s.upcase
end

def report_entry_colors(report, label, name, expected_fore, expected_back)
  entry = import_entry_for(name)
  actual = if entry
             "#{entry[:fore].inspect} on #{entry[:back].inspect}"
           else
             '(missing)'
           end
  report << "CHECK: #{label} expected #{expected_fore.inspect} on #{expected_back.inspect}; actual #{actual}"
end

def assert_test(report, label)
  if yield
    report << "PASS: #{label}"
  else
    report << "FAIL: #{label}"
  end
rescue => error
  report << "FAIL: #{label}: #{error.class}: #{error.message}"
end

def run_command_selftest(report, transcript_token)
  tag_input = 'NhDebug'
  tag = 'Nhdebug'
  names = {
    custom_one: 'Nhdebugone',
    custom_two: 'Nhdebugtwo',
    race: 'Nhdebugrace',
    profession: 'Nhdebugprof',
    mode: 'Nhdebugmode',
    bulk_one: 'Nhdebugbulkone',
    bulk_two: 'Nhdebugbulktwo',
    import_one: 'Nhdebugimportone',
    import_two: 'Nhdebugimporttwo',
    import_combo: 'Nhdebugimportcombo',
    orphan_holder: 'Nhdebugorphanholder',
  }

  report << 'mode: command self-test with restore'
  report << 'note: temporarily changes Highlight Manager files, then restores them.'
  snapshot = snapshot_files

  run_highlight_manager_command(report, transcript_token, ['version'], 60)
  assert_test(report, 'version command reports Highlight Manager version') do
    command_transcript_includes?(transcript_token, 'Highlight Manager v')
  end

  run_highlight_manager_command(report, transcript_token, ['tag', tag_input, '#112233', '#445566'], 60)
  assert_test(report, 'custom tag color was saved') { config_tag_color(tag) == ['#112233', '#445566'] }

  run_highlight_manager_command(report, transcript_token, ['addcustom', tag_input, names[:custom_one], names[:custom_two]], 60)
  assert_test(report, 'custom test names were tagged') do
    record_has?(names[:custom_one], 'custom_tag', tag) && record_has?(names[:custom_two], 'custom_tag', tag)
  end
  assert_test(report, 'custom test names were written to import') do
    import_contains_text?(names[:custom_one]) && import_contains_text?(names[:custom_two])
  end

  run_highlight_manager_command(report, transcript_token, ['addrace', 'Human', names[:race]], 60)
  assert_test(report, 'manual race data was saved') { record_has?(names[:race], 'manual_race', 'Human') }

  run_highlight_manager_command(report, transcript_token, ['addprof', 'Wizard', names[:profession]], 60)
  assert_test(report, 'manual profession data was saved') { record_has?(names[:profession], 'manual_profession', 'Wizard') }

  run_highlight_manager_command(report, transcript_token, ['addrace', 'Human', names[:mode]], 60)
  run_highlight_manager_command(report, transcript_token, ['addprof', 'Wizard', names[:mode]], 60)
  assert_test(report, 'mode test manual race/profession data was saved') do
    record_has?(names[:mode], 'manual_race', 'Human') && record_has?(names[:mode], 'manual_profession', 'Wizard')
  end
  profession_pair = configured_profession_pair('Wizard')
  human_pair = configured_race_pair('Human')
  assert_test(report, 'mode test colors are available') { profession_pair && human_pair }

  run_highlight_manager_command(report, transcript_token, ['lookup', names[:mode]], 60)
  assert_test(report, 'single-name lookup reports manual race/profession data') do
    command_transcript_includes?(transcript_token, "Highlight Manager lookup: #{names[:mode].capitalize}") &&
      command_transcript_includes?(transcript_token, 'Wizard (manual)') &&
      command_transcript_includes?(transcript_token, 'Human (manual)')
  end

  run_highlight_manager_command(report, transcript_token, ['lookup', names[:custom_one], names[:mode]], 60)
  assert_test(report, 'multi-name lookup prints compact lines') do
    command_transcript_includes?(transcript_token, 'Highlight Manager lookup: 2 name(s)') &&
      command_transcript_includes?(transcript_token, names[:mode].capitalize) &&
      command_transcript_includes?(transcript_token, 'Human*') &&
      command_transcript_includes?(transcript_token, 'Wizard*')
  end

  run_highlight_manager_command(report, transcript_token, ['mode', 'profession'], 60)
  report_entry_colors(report, 'profession mode', names[:mode], profession_pair && profession_pair[0], profession_pair && profession_pair[1])
  assert_test(report, 'profession mode rewrote import with profession colors') do
    profession_pair && entry_colors_match?(names[:mode], profession_pair[0], profession_pair[1])
  end

  run_highlight_manager_command(report, transcript_token, ['mode', 'race'], 60)
  report_entry_colors(report, 'race mode', names[:mode], human_pair && human_pair[0], human_pair && human_pair[1])
  assert_test(report, 'race mode rewrote import with race colors') do
    human_pair && entry_colors_match?(names[:mode], human_pair[0], human_pair[1])
  end

  run_highlight_manager_command(report, transcript_token, ['mode', 'race_profession'], 60)
  report_entry_colors(report, 'race+profession mode', names[:mode], human_pair && human_pair[0], profession_pair && profession_pair[1])
  assert_test(report, 'race+profession mode rewrote import with race text and profession background') do
    profession_pair && human_pair && entry_colors_match?(names[:mode], human_pair[0], profession_pair[1])
  end

  run_highlight_manager_command(report, transcript_token, ['mode', 'custom'], 60)
  assert_test(report, 'custom-only mode keeps custom tagged names in import') do
    import_contains_text?(names[:custom_one]) && import_contains_text?(names[:custom_two])
  end
  assert_test(report, 'custom-only mode excludes untagged automatic names from import') do
    !import_contains_text?(names[:mode])
  end

  run_highlight_manager_command(report, transcript_token, ['addcustom', "#{tag_input}:", names[:bulk_one], names[:bulk_two]], 60)
  assert_test(report, 'tag:name bulk command parsing tags multiple names') do
    record_has?(names[:bulk_one], 'custom_tag', tag) && record_has?(names[:bulk_two], 'custom_tag', tag)
  end

  importxml_path = File.join(export_dir, "highlight-manager-importxml-test-#{Time.now.strftime('%Y%m%d-%H%M%S')}.xml")
  write_importxml_test_source(importxml_path)
  orphan_tag = next_imported_tag_without_color
  write_orphan_imported_tag_record(names[:orphan_holder], orphan_tag)
  report << "CHECK: created orphaned #{orphan_tag} record before importxml collision test"
  run_highlight_manager_command(report, transcript_token, ['importxml', importxml_path], 60)
  imported_tag_one = record_field(names[:import_one], 'custom_tag')
  imported_tag_two = record_field(names[:import_two], 'custom_tag')
  assert_test(report, 'importxml imports existing Name highlights into character data') do
    !imported_tag_one.empty? && imported_tag_one == imported_tag_two
  end
  assert_test(report, 'importxml-created tag color is saved') do
    pair = config_tag_color(imported_tag_one)
    pair == ['#AA5500', '#001122']
  end
  assert_test(report, 'importxml avoids orphaned Imported # label names') do
    !orphan_tag.to_s.empty? && imported_tag_one != orphan_tag && config_tag_color(orphan_tag).nil?
  end
  assert_test(report, 'importxml imported names are written to import') do
    import_contains_text?(names[:import_one]) && import_contains_text?(names[:import_two])
  end
  assert_test(report, 'importxml automatic race+profession colors save usable character data') do
    record_has?(names[:import_combo], 'profession', 'Bard') &&
      record_has?(names[:import_combo], 'race', 'Human') &&
      record_has?(names[:import_combo], 'custom_tag', '')
  end
  File.delete(importxml_path) if File.exist?(importxml_path)

  run_highlight_manager_command(report, transcript_token, ['cleanup', 'imports'], 60)
  assert_test(report, 'cleanup imports removes generated Imported # labels from names') do
    record_has?(names[:import_one], 'custom_tag', '') && record_has?(names[:import_two], 'custom_tag', '')
  end
  assert_test(report, 'cleanup imports removes unused Imported # color groups') do
    config_tag_color(imported_tag_one).nil?
  end

  run_highlight_manager_command(report, transcript_token, ['currentxml', 'debug'], 60)
  report << 'PASS: currentxml debug command completed'

  run_highlight_manager_command(report, transcript_token, ['remove', names[:custom_one], names[:custom_two]], 60)
  assert_test(report, 'manual custom tags were removed from test names') do
    record_has?(names[:custom_one], 'custom_tag', '') && record_has?(names[:custom_two], 'custom_tag', '')
  end

  run_highlight_manager_command(report, transcript_token, ['untag', tag_input], 60)
  assert_test(report, 'custom tag color was removed') { config_tag_color(tag).nil? }
ensure
  restore_files(snapshot, report) if snapshot
  restored_config = test_config
  restored_records = test_records
  restored_tags = restored_config['tag_colors'].is_a?(Hash) ? restored_config['tag_colors'] : {}
  leftovers = names ? names.values.select { |name| restored_records.key?(name.downcase) } : []
  report << "PASS: test tag removed after restore" unless restored_tags.key?(tag)
  report << "PASS: test names removed after restore" if leftovers.empty?
  report << "FAIL: test names still present after restore: #{leftovers.join(', ')}" unless leftovers.empty?
end

def run_datafolder_selftest(report, transcript_token)
  report << 'mode: data folder self-test with restore'
  report << 'note: temporarily changes the Highlight Manager data folder, verifies it, then restores files.'
  snapshot = snapshot_files
  original_export_dir = export_dir
  temp_dir = File.join(original_export_dir, "highlight-manager-datafolder-test-#{Time.now.strftime('%Y%m%d-%H%M%S')}")

  run_highlight_manager_command(report, transcript_token, ['datafolder', temp_dir], 60)
  config = test_config
  configured = File.expand_path(config['data_folder'].to_s)
  expected = File.expand_path(temp_dir)
  assert_test(report, 'datafolder command saved the requested folder') { configured == expected }
  assert_test(report, 'datafolder command created the requested folder') { Dir.exist?(temp_dir) }
  assert_test(report, 'datafolder command copied character data when available') do
    !File.exist?(File.join(original_export_dir, 'highlight-manager-characterdata.yml')) ||
      File.exist?(File.join(temp_dir, 'highlight-manager-characterdata.yml'))
  end
ensure
  restore_files(snapshot, report) if snapshot
  begin
    FileUtils.rm_rf(temp_dir) if temp_dir && Dir.exist?(temp_dir)
    report << 'OK: removed temporary data folder test folder.'
  rescue => error
    report << "WARN: failed to clean up temporary data folder #{temp_dir}: #{error.class}: #{error.message}"
  end
end

def run_full_command_selftest(report, transcript_token)
  report << 'mode: full command self-test with restore'
  report << 'note: uses temporary copy XML files and restores Highlight Manager files afterward.'
  snapshot = snapshot_files
  temp_root = File.join(export_dir, "highlight-manager-copy-test-#{Time.now.strftime('%Y%m%d-%H%M%S')}")
  source_path = File.join(temp_root, 'source.xml')
  target_dir = File.join(temp_root, 'targets')
  target_path = File.join(target_dir, '123456.xml')

  run_command_selftest(report, transcript_token)
  run_datafolder_selftest(report, transcript_token)

  run_highlight_manager_command(report, transcript_token, ['list'], 60)
  report << 'PASS: list command completed'

  run_highlight_manager_command(report, transcript_token, ['lookup', 'room'], 60)
  report << 'PASS: lookup room command completed'

  run_highlight_manager_command(report, transcript_token, ['changes'], 60)
  report << 'PASS: changes command completed'

  run_highlight_manager_command(report, transcript_token, ['legend', 'window'], 60)
  report << 'PASS: legend window command completed'

  run_highlight_manager_command(report, transcript_token, ['legend', 'close'], 60)
  report << 'PASS: legend close command completed'

  write_copy_test_source(source_path)
  write_copy_test_target(target_path)

  run_highlight_manager_command(report, transcript_token, ['frontend', 'wrayth'], 60)
  report << 'CHECK: switched frontend preference to Wrayth for temporary copy tests.'
  assert_test(report, 'frontend command saved Wrayth preference for copy tests') do
    test_config['frontend'].to_s == 'wrayth'
  end

  run_highlight_manager_command(report, transcript_token, ['copy', 'setup', "source=#{source_path}", "target=#{target_dir}", 'duplicates=skip'], 60)
  if command_transcript_includes?(transcript_token, 'Warlock users should use Warlock Settings')
    report << 'PASS: copy tests skipped because this frontend should use Warlock Global import instead.'
  else
    assert_test(report, 'copy setup saved temporary skip settings') do
      config = test_config
      settings = config['copy_settings'].is_a?(Hash) ? config['copy_settings'] : {}
      settings['source_path'] == source_path && settings['target_dir'] == target_dir && settings['duplicates'] == 'skip' && !settings['confirmed']
    end

    backup_target_dir = File.join(target_dir, 'highlight-manager-backups', "copy-#{Time.now.strftime('%Y%m%d-%H%M%S')}")
    FileUtils.mkdir_p(backup_target_dir)
    write_copy_test_target(File.join(backup_target_dir, '654321.xml'))
    run_highlight_manager_command(report, transcript_token, ['copy', 'setup', "source=#{source_path}", "target=#{backup_target_dir}", 'duplicates=skip'], 60)
    assert_test(report, 'copy setup rejects generated backup folders as targets') do
      config = test_config
      settings = config['copy_settings'].is_a?(Hash) ? config['copy_settings'] : {}
      settings['target_dir'] != backup_target_dir
    end

    run_highlight_manager_command(report, transcript_token, ['copy', 'confirm', "source=#{source_path}", "target=#{target_dir}", 'duplicates=skip'], 60)
    assert_test(report, 'copy skip kept existing duplicate and added missing name') do
      existing = copy_test_target_entry(target_path, 'names', 'Copyalpha')
      existing && existing[:fore] == '#000000' && copy_test_entry_exists?(target_path, 'names', 'Copybeta')
    end

    write_copy_test_target(target_path)
    run_highlight_manager_command(report, transcript_token, ['copy', 'confirm', "source=#{source_path}", "target=#{target_dir}", 'duplicates=replace'], 60)
    assert_test(report, 'copy replace overwrote duplicate and kept unrelated name') do
      existing = copy_test_target_entry(target_path, 'names', 'Copyalpha')
      existing && existing[:fore] == '#111111' && copy_test_entry_exists?(target_path, 'names', 'Keepname')
    end

    write_copy_test_target(target_path)
    run_highlight_manager_command(report, transcript_token, ['copy', 'confirm', "source=#{source_path}", "target=#{target_dir}", 'duplicates=clear'], 60)
    assert_test(report, 'copy clear removed unrelated name and added source names') do
      copy_test_entry_exists?(target_path, 'names', 'Copyalpha') &&
        copy_test_entry_exists?(target_path, 'names', 'Copybeta') &&
        !copy_test_entry_exists?(target_path, 'names', 'Keepname')
    end

    run_highlight_manager_command(report, transcript_token, ['copy', 'status'], 60)
    report << 'PASS: copy status command completed after copy tests'
  end

  run_highlight_manager_command(report, transcript_token, ['reset'], 60)
  assert_test(report, 'reset cleared character data during temporary test') { test_records.empty? }
ensure
  restore_files(snapshot, report) if snapshot
  begin
    FileUtils.rm_rf(temp_root) if temp_root && Dir.exist?(temp_root)
    report << 'OK: removed temporary copy test folder.'
  rescue => error
    report << "WARN: failed to clean up temporary copy test folder #{temp_root}: #{error.class}: #{error.message}"
  end
end

def add_command_capture_report(report, args)
  mode = command_capture_mode(args)
  return unless mode

  transcript_token = command_transcript_token
  transcript = command_transcript_path(transcript_token)
  report << ''
  report << 'Command Capture'
  report << '---------------'
  report << "transcript: #{transcript}"
  if lich_script_runner_available? && highlight_manager_running_exact?
    message = 'A Highlight Manager command is already running. Stop it before running the diagnostic command tests.'
    report << "WARN: #{message}"
    nd_echo message
    return
  end

  if mode == :fulltest
    nd_echo 'Highlight Manager full diagnostic test starting...'
    run_full_command_selftest(report, transcript_token)
  elsif mode == :test
    nd_echo 'Highlight Manager command diagnostic test starting...'
    run_command_selftest(report, transcript_token)
  elsif mode == :safe
    nd_echo 'Highlight Manager safe diagnostic commands starting...'
    report << 'mode: safe commands only'
    run_highlight_manager_command(report, transcript_token, ['mode'], 60)
    run_highlight_manager_command(report, transcript_token, ['lookup', 'room'], 60)
    run_highlight_manager_command(report, transcript_token, ['legend'], 60)
    run_highlight_manager_command(report, transcript_token, ['copy', 'status'], 60)
  else
    nd_echo 'Highlight Manager live scan diagnostic starting...'
    report << 'mode: live scan'
    report << "note: this runs ;#{main_command_name} debug, which scans WHO and rewrites the import file."
    run_highlight_manager_command(report, transcript_token, ['debug'], 240)
  end
end

raw_args = script_args
if help_requested?(raw_args)
  show_usage
  exit
end

legacy_migration_notes = migrate_legacy_files_for_report
report = []
add_environment_report(report)
unless legacy_migration_notes.empty?
  report << ''
  report << 'Legacy File Migration'
  report << '---------------------'
  legacy_migration_notes.each { |line| report << line }
end
migrate_saved_legacy_paths_for_report(report)
add_lich_temp_report(report)
initial_config = safe_yaml(config_path, 'config', report)
add_backup_report(report, initial_config) if backup_requested?(raw_args)
add_command_capture_report(report, raw_args)
migrate_saved_legacy_paths_for_report(report)
config = safe_yaml(config_path, 'config', report)
report << 'OK: config reloaded after command capture.' if command_capture_mode(raw_args)
data = safe_yaml(character_data_path, 'character data', report)
add_config_report(report, config)
add_character_data_report(report, data)
add_import_report(report, config, data)

warnings = report.count { |line| line.start_with?('WARN:') }
errors = report.count { |line| line.start_with?('ERROR:') }
failures = report.count { |line| line.start_with?('FAIL:') }
report << ''
report << 'Summary'
report << '-------'
report << "warnings: #{warnings}"
report << "errors: #{errors}"
report << "test failures: #{failures}"
report << 'No live character files were changed.'

path = report_path
File.write(path, report.join("\n") + "\n")
if cleanlogs_requested?(raw_args)
  cleanup_report = []
  add_cleanlogs_report(cleanup_report, path)
  File.open(path, 'a') { |file| file.write(cleanup_report.join("\n") + "\n") }
  report.concat(cleanup_report)
end
nd_echo "Highlight Manager diagnostic report written:"
nd_echo "  #{path}"
nd_echo "Warnings: #{warnings}, Errors: #{errors}, Test failures: #{failures}"
