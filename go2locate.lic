# encoding: utf-8
=begin

  go2locate.lic - Attempts to make go2 take you to the last room you located.
  Optionally casts Locate Person (116) on a target first.

  Usage:
    ;go2locate              (uses last locate in buffer)
    ;go2locate <name>       (casts locate on name first, then navigates)

  tillmen@lichproject.org (bugfixed)

=end

# If a name was passed, cast locate on them first
if script.vars[1]
  target = script.vars[1]

  result = dothistimeout "prepare 116", 10, /Your spell is ready|already preparing/i
  if result.nil?
    echo "go2locate: Timed out waiting to prepare spell."
    exit
  end

  result = dothistimeout "cast #{target}", 10, /Cast Roundtime|your sight begins to clear|beyond the reach|What were you referring|unseen force|withers/i
  if result.nil?
    echo "go2locate: Timed out waiting for cast result."
    exit
  end

  waitrt
end

# Search the server buffer for the most recent locate vision
room_title       = nil
room_description = nil
room_exits_string = nil

buffer = $_SERVERBUFFER_.dup rescue []
buffer = (buffer + buffer.history rescue buffer)
history = buffer.reverse

history.each_index do |i|
  if history[i] =~ /your sight begins to clear and a vision/i
    # Search forward in the reversed buffer (i.e. lines that came after the trigger)
    window = history[(i - 15).clamp(0, history.length)..i].reverse
    window.each do |line|
      clean = line.gsub(/<.*?>/, '').strip

      if line =~ /<style id="roomName" \/>(.*)$/ || line =~ /^\[(.+?) - \d+\]/
        room_title = ($1 || clean).strip
      elsif line =~ /<style id="roomDesc"\/>.*?<style id=""\/>/
        room_description = line.gsub(/<.*?>/, '').strip
      elsif room_description.nil? && clean.length > 40 && clean !~ /^(Also here|Obvious|You also)/
        # Fallback: treat long descriptive lines as room description
        room_description ||= clean
      elsif clean =~ /(Obvious (?:paths|exits): .+)/
        room_exits_string = $1.strip
      end
    end
    break
  end
end

unless room_title
  echo "go2locate: Could not find a locate vision in your buffer. Locate someone and try again."
  exit
end

unless room_description
  echo "go2locate: Room description not found. Make sure description display is on."
  exit
end

unless room_exits_string
  echo "go2locate: Could not find obvious exits from the located room."
  exit
end

# Try exact match first
room = Map.list.find { |r| r.title.include?(room_title) && r.desc.include?(room_description) && r.paths.include?(room_exits_string) }

# Fuzzy description match if exact fails
unless room
  desc_regex = /#{Regexp.escape(room_description).gsub(/\\\.(?:\\\.\\\.)?/, '|')}/
  room = Map.list.find { |r| r.title.include?(room_title) && r.paths.include?(room_exits_string) && r.desc.find { |d| d =~ desc_regex } }
end

# Title + exits only as last resort
unless room
  room = Map.list.find { |r| r.title.include?(room_title) && r.paths.include?(room_exits_string) }
end

unless room
  echo "go2locate: Could not find a matching room in the map database for the last locate."
  echo "go2locate: Title: #{room_title}"
  echo "go2locate: Exits: #{room_exits_string}"
  exit
end

echo "go2locate: Navigating to room #{room.id} -- #{room_title}"
start_script 'go2', [room.id.to_s]
