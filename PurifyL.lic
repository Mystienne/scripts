    exit
    end
    GameObj.inv.find{|cont| cont.noun =~ /#{UserVars.PurifyL[:unsungcontainer]}/}.contents.each{|gem| mygems.push(gem.id.to_i) if (gem.noun =~ /#{$gemnouns.join('|')}/ || gem.name =~ /#{$gemnames.join('|')}/) && gem.name !~ /smooth stone/}
