	end
	
mygems.each{|gem|
if purified + shattered + orbs + alreadyorbs == 0
    respond "~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~"
