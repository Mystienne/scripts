	respond "~ #{totalboost}% Total Boost / #{totalboost/(purified + orbs)}% Average Boost" if (purified + orbs) > 0
    respond "~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~"
    end
    wait_rt
    orbed = false
